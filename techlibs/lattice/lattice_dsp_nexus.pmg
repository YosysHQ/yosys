pattern nexus_mac9_4lane

// maccmap -unmap adds the addends first, then one product per $add:
// (((C + P0) + P1) + P2) + P3, or ((P0 + P1) + P2) + P3 without C

match add3
	select add3->type == $add
	select GetSize(port(add3, \Y)) <= 54
endmatch

match mul3
	select mul3->type == $mul
	select GetSize(port(mul3, \A)) <= 9 && GetSize(port(mul3, \B)) <= 9
	select nusers(port(mul3, \Y)) == 2
	index <SigBit> port(mul3, \Y)[0] === port(add3, \B)[0]
endmatch

match add2
	select add2->type == $add
	select nusers(port(add2, \Y)) == 2
	index <SigBit> port(add2, \Y)[0] === port(add3, \A)[0]
endmatch

match mul2
	select mul2->type == $mul
	select GetSize(port(mul2, \A)) <= 9 && GetSize(port(mul2, \B)) <= 9
	select nusers(port(mul2, \Y)) == 2
	index <SigBit> port(mul2, \Y)[0] === port(add2, \B)[0]
endmatch

match add1
	select add1->type == $add
	select nusers(port(add1, \Y)) == 2
	index <SigBit> port(add1, \Y)[0] === port(add2, \A)[0]
endmatch

match mul1
	select mul1->type == $mul
	select GetSize(port(mul1, \A)) <= 9 && GetSize(port(mul1, \B)) <= 9
	select nusers(port(mul1, \Y)) == 2
	index <SigBit> port(mul1, \Y)[0] === port(add1, \B)[0]
endmatch

// C + P0
match add0
	select add0->type == $add
	select nusers(port(add0, \Y)) == 2
	index <SigBit> port(add0, \Y)[0] === port(add1, \A)[0]
	optional
endmatch

match mul0
	select mul0->type == $mul
	select GetSize(port(mul0, \A)) <= 9 && GetSize(port(mul0, \B)) <= 9
	select nusers(port(mul0, \Y)) == 2
	index <SigBit> port(mul0, \Y)[0] === (add0 ? port(add0, \B)[0] : port(add1, \A)[0])
endmatch

code
	{
		int width = GetSize(port(add3, \Y));
		bool is_signed = param(mul0, \A_SIGNED).as_bool();
		for (auto mul : {mul0, mul1, mul2, mul3})
			if (param(mul, \A_SIGNED).as_bool() != is_signed || param(mul, \B_SIGNED).as_bool() != is_signed)
				reject;

		// Each adder must see the exact products and partial sums in the width of the top one
		SigSpec p0 = nexus_product_bits(mul0, port(mul0, \Y), width);
		SigSpec p1 = nexus_product_bits(mul1, port(mul1, \Y), width);
		SigSpec p2 = nexus_product_bits(mul2, port(mul2, \Y), width);
		SigSpec p3 = nexus_product_bits(mul3, port(mul3, \Y), width);
		SigSpec s1 = add0 ? nexus_sum_bits(port(add0, \Y), width) : p0;
		SigSpec s2 = nexus_sum_bits(port(add1, \Y), width);
		SigSpec s3 = nexus_sum_bits(port(add2, \Y), width);
		if (!nexus_operand_is(port(add3, \A), nexus_add_signed(add3), s3) || !nexus_operand_is(port(add3, \B), nexus_add_signed(add3), p3))
			reject;
		if (!nexus_operand_is(port(add2, \A), nexus_add_signed(add2), s2) || !nexus_operand_is(port(add2, \B), nexus_add_signed(add2), p2))
			reject;
		if (!nexus_operand_is(port(add1, \A), nexus_add_signed(add1), s1) || !nexus_operand_is(port(add1, \B), nexus_add_signed(add1), p1))
			reject;
		if (add0 && !nexus_operand_is(port(add0, \B), nexus_add_signed(add0), p0))
			reject;

		SigSpec sigC;
		if (add0) {
			sigC = port(add0, \A);
			sigC.extend_u0(width, nexus_add_signed(add0));
			// C must not read cells that are removed
			for (auto cell : {mul0, mul1, mul2, mul3, add0, add1, add2, add3})
				if (!sigC.extract(port(cell, \Y)).empty())
					reject;
		}
		sigC.extend_u0(54, false);

		SigSpec sigY = port(add3, \Y);
		if (width < 54)
			sigY.append(module->addWire(NEW_ID, 54 - width));

		Cell *mac = module->addCell(NEW_ID, "$__NX_MAC9X9WIDE_4LANE");
		int i = 0;
		for (auto mul : {mul0, mul1, mul2, mul3}) {
			SigSpec sigA = port(mul, \A);
			SigSpec sigB = port(mul, \B);
			sigA.extend_u0(9, is_signed);
			sigB.extend_u0(9, is_signed);
			mac->setPort(stringf("\\A%d", i), sigA);
			mac->setPort(stringf("\\B%d", i), sigB);
			i++;
		}
		mac->setPort(\C, sigC);
		mac->setPort(\Y, sigY);
		mac->setParam(\SIGNED, is_signed ? State::S1 : State::S0);

		for (auto cell : {mul0, mul1, mul2, mul3, add0, add1, add2, add3})
			autoremove(cell);
	}

	accept;
endcode

pattern nexus_mac

state <IdString> add_AB add_C mux_add mux_mul

match mul
	select mul->type.in($mul)
	select param(mul, \A_SIGNED).as_bool() == param(mul, \B_SIGNED).as_bool()
	select GetSize(port(mul, \A)) <= 36
	select GetSize(port(mul, \B)) <= 36
endmatch

match add
	select add->type.in($add, $sub)
	select GetSize(port(add, \Y)) <= 108
	choice <IdString> AB {\A, \B}
	define <IdString> BA (AB == \A ? \B : \A)
	filter add->type == $add || AB == \B
	index <SigBit> port(add, AB)[0] === port(mul, \Y)[0]
	set add_AB AB
	set add_C BA
endmatch

// Clear: S ? A * B : C + A * B becomes (S ? 0 : C) + A * B
match mux
	select mux->type == $mux
	choice <IdString> AB {\A, \B}
	define <IdString> BA (AB == \A ? \B : \A)
	index <SigSpec> port(mux, AB) === port(add, \Y)
	set mux_add AB
	set mux_mul BA
	optional
endmatch

code
	{
		int width = GetSize(port(add, \Y));
		bool add_signed = nexus_add_signed(add);
		SigSpec product = nexus_product_bits(mul, port(mul, \Y), width);
		if (!nexus_operand_is(port(add, add_AB), add_signed, product))
			reject;

		SigSpec sigC = port(add, add_C);
		if (!sigC.extract(port(mul, \Y)).empty())
			reject;

		if (mux) {
			if (add->type != $add || port(mux, mux_mul) != product)
				reject;
			// Don't read removed cells
			SigSpec sel = port(mux, \S);
			if (!sel.extract(port(mul, \Y)).empty() || !sel.extract(port(add, \Y)).empty())
				reject;
			if (nusers(port(mul, \Y)) != 3 || nusers(port(add, \Y)) != 2)
				reject;
		} else if (nusers(port(mul, \Y)) != 2) {
			reject;
		}

		bool small = GetSize(port(mul, \A)) <= 18 && GetSize(port(mul, \B)) <= 18;
		// Narrow muls don't take a whole 36x36 block for a wide sum
		if (small && width > 54)
			reject;
		int ab_width = small ? 18 : 36;
		int z_width = small ? 54 : 108;

		bool ab_signed = param(mul, \A_SIGNED).as_bool();
		SigSpec sigA = port(mul, \A);
		SigSpec sigB = port(mul, \B);
		SigSpec sigY = mux ? port(mux, \Y) : port(add, \Y);
		sigA.extend_u0(ab_width, ab_signed);
		sigB.extend_u0(ab_width, ab_signed);
		sigC.extend_u0(width, add_signed);
		if (mux) {
			SigSpec zero(State::S0, width);
			SigSpec sel = port(mux, \S);
			if (mux_add == \A)
				sigC = module->Mux(NEW_ID, sigC, zero, sel);
			else
				sigC = module->Mux(NEW_ID, zero, sigC, sel);
		}
		sigC.extend_u0(z_width, false);
		if (width < z_width)
			sigY.append(module->addWire(NEW_ID, z_width - width));

		Cell *mac = module->addCell(NEW_ID, small ? "$__NX_MAC18X18" : "$__NX_MAC36X36");
		mac->setPort(\A, sigA);
		mac->setPort(\B, sigB);
		mac->setPort(\C, sigC);
		mac->setPort(\Y, sigY);
		mac->setParam(\A_SIGNED, param(mul, \A_SIGNED));
		mac->setParam(\SUBTRACT, add->type == $sub ? State::S1 : State::S0);

		autoremove(mul);
		autoremove(add);
		autoremove(mux);
	}

	accept;
endcode

pattern nexus_preadd18

match preadd
	select preadd->type.in($add, $sub)
	select GetSize(port(preadd, \Y)) <= 19
	select nusers(port(preadd, \Y)) == 2
endmatch

match mul
	select mul->type.in($mul)
	select GetSize(port(mul, \Y)) <= 48
	choice <IdString> mul_AB {\A, \B}
	index <SigBit> port(mul, mul_AB)[0] === port(preadd, \Y)[0]
endmatch

match pipe_ff
	select pipe_ff->type.in($dff, $dffe, $sdff, $sdffe)
	index <SigBit> port(pipe_ff, \D)[0] === port(mul, \Y)[0]
	filter nusers(port(mul, \Y)) == 2
	optional
endmatch

code
	SigSpec preadd_out = port(preadd, \Y);
	IdString actual_mul_AB;

	if (GetSize(port(mul, \A)) >= GetSize(preadd_out) && port(mul, \A).extract(0, GetSize(preadd_out)) == preadd_out) {
		actual_mul_AB = \A;
	} else if (GetSize(port(mul, \B)) >= GetSize(preadd_out) && port(mul, \B).extract(0, GetSize(preadd_out)) == preadd_out) {
		actual_mul_AB = \B;
	} else {
		reject;
	}

	{
		Cell *mac = module->addCell(NEW_ID, "$__NX_PREADD18X18");

		IdString mul_other = (actual_mul_AB == \A) ? \B : \A;
		IdString sgn_AC = (mul_other == \A) ? \B_SIGNED : \A_SIGNED;
		IdString sgn_B = (mul_other == \A) ? \A_SIGNED : \B_SIGNED;

		SigSpec sig_A = port(preadd, \A);
		SigSpec sig_C = port(preadd, \B);
		SigSpec sig_B = port(mul, mul_other);

		sig_A.extend_u0(18, false);
		sig_C.extend_u0(18, false);
		sig_B.extend_u0(18, false);

		mac->setPort(\A, sig_A.extract(0, 18));
		mac->setPort(\C, sig_C.extract(0, 18));
		mac->setPort(\B, sig_B.extract(0, 18));

		if (pipe_ff) {
			mac->setPort(\Y, port(pipe_ff, \Q));
			mac->setPort(\CLK, port(pipe_ff, \CLK));
			mac->setParam(\PIPELINED, State::S1);
		} else {
			mac->setPort(\Y, port(mul, \Y));
			mac->setPort(\CLK, State::S0);
			mac->setParam(\PIPELINED, State::S0);
		}

		mac->setParam(\A_SIGNED, mul->getParam(sgn_AC));
		mac->setParam(\B_SIGNED, mul->getParam(sgn_B));
		mac->setParam(\C_SIGNED, mul->getParam(sgn_AC));

		if (pipe_ff) autoremove(pipe_ff);
		autoremove(mul);
		autoremove(preadd);
	}

	accept;
endcode

pattern nexus_mul_reg

state <SigBit> clk
state <SigSpec> argQ argD
state <Cell*> ffA ffB ffY

udata <Cell*> dff
udata <SigBit> dffclk
udata <SigSpec> dffD dffQ

match mul
	select mul->type.in($mul)
	select GetSize(port(mul, \A)) <= 36
	select GetSize(port(mul, \B)) <= 36
	select GetSize(port(mul, \Y)) <= 72
endmatch

// Absorb the pipeline FF on each mul input
code argQ ffA clk
	argQ = port(mul, \A);
	subpattern(in_ff);
	if (dff) {
		ffA = dff;
		clk = dffclk;
	}
endcode

code argQ ffB clk
	argQ = port(mul, \B);
	subpattern(in_ff);
	if (dff) {
		ffB = dff;
		clk = dffclk;
	}
endcode

// Absorb the FF on the mul output
code argD ffY clk
	argD = port(mul, \Y);
	subpattern(out_ff);
	if (dff) {
		ffY = dff;
		clk = dffclk;
	}
endcode

code
	if (!ffA && !ffB && !ffY)
		reject;

	{
		int aw = GetSize(port(mul, \A));
		int bw = GetSize(port(mul, \B));
		IdString prim;
		int A_PINS;
		int B_PINS;

		if (aw <= 18 && bw <= 18) {
			prim = "$__NX_MUL18X18";
			A_PINS = 18;
			B_PINS = 18;
		} else if (aw <= 36 && bw <= 18) {
			prim = "$__NX_MUL36X18";
			A_PINS = 36;
			B_PINS = 18;
		} else if (aw <= 18 && bw <= 36) {
			prim = "$__NX_MUL36X18";
			A_PINS = 36;
			B_PINS = 18;
		} else {
			prim = "$__NX_MUL36X36";
			A_PINS = 36;
			B_PINS = 36;
		}

		bool a_signed = mul->getParam(\A_SIGNED).as_bool();
		bool b_signed = mul->getParam(\B_SIGNED).as_bool();
		// Drive the DSP from the FF's D
		SigSpec sigA = ffA ? port(ffA, \D) : port(mul, \A);
		SigSpec sigB = ffB ? port(ffB, \D) : port(mul, \B);
		SigSpec sigY = ffY ? port(ffY, \Q) : port(mul, \Y);

		// 36X18 -> wide operand goes to A
		Cell *ffa = ffA;
		Cell *ffb = ffB;
		if (prim == "$__NX_MUL36X18" && aw <= 18 && bw <= 36) {
			std::swap(sigA, sigB);
			std::swap(a_signed, b_signed);
			std::swap(ffa, ffb);
		}

		sigA.extend_u0(A_PINS, a_signed);
		sigB.extend_u0(B_PINS, b_signed);

		Cell *cell = module->addCell(NEW_ID, prim);
		cell->setPort(\A, sigA);
		cell->setPort(\B, sigB);
		cell->setPort(\Y, sigY);
		cell->setParam(\A_WIDTH, A_PINS);
		cell->setParam(\B_WIDTH, B_PINS);
		cell->setParam(\Y_WIDTH, GetSize(sigY));
		cell->setParam(\A_SIGNED, a_signed ? State::S1 : State::S0);
		cell->setParam(\B_SIGNED, b_signed ? State::S1 : State::S0);
		cell->setParam(\RESETMODE, std::string("SYNC"));

		auto ce_of = [&](Cell *ff) -> SigBit {
			if (!ff) return State::S0;

			if (ff->type.in($dffe, $sdffe)) {
				SigBit e = port(ff, \EN)[0];
				if (!ff->getParam(\EN_POLARITY).as_bool())
					e = module->NotGate(NEW_ID, e);

				return e;
			}

			return State::S1; // Always enabled
		};

		auto rst_of = [&](Cell *ff) -> SigBit {
			if (!ff) return State::S0;

			if (ff->type.in($sdff, $sdffe)) {
				SigBit r = port(ff, \SRST)[0];
				if (!ff->getParam(\SRST_POLARITY).as_bool())
					r = module->NotGate(NEW_ID, r);

				return r;
			}

			return State::S0; // No reset
		};

		cell->setPort(\CLK, clk != SigBit() ? clk : State::S0);
		cell->setPort(\CEA, ce_of(ffa));
		cell->setPort(\RSTA, rst_of(ffa));
		cell->setPort(\CEB, ce_of(ffb));
		cell->setPort(\RSTB, rst_of(ffb));
		cell->setPort(\CEOUT, ce_of(ffY));
		cell->setPort(\RSTOUT, rst_of(ffY));
		cell->setParam(\REGINPUTA, ffa ? std::string("REGISTER") : std::string("BYPASS"));
		cell->setParam(\REGINPUTB, ffb ? std::string("REGISTER") : std::string("BYPASS"));
		cell->setParam(\REGOUTPUT, ffY ? std::string("REGISTER") : std::string("BYPASS"));

		if (ffa) autoremove(ffa);
		if (ffb && ffb != ffa) autoremove(ffb);
		if (ffY) autoremove(ffY);
		autoremove(mul);

		accept;
	}
endcode

// Find the input pipeline FF whose Q feeds argQ
subpattern in_ff
arg argQ clk

code
	dff = nullptr;
endcode

match ff
	select ff->type.in($dff, $dffe, $sdff, $sdffe)
	select param(ff, \CLK_POLARITY).as_bool()
	filter ff->type.in($dff, $dffe) || param(ff, \SRST_VALUE).is_fully_zero()
	filter GetSize(port(ff, \Q)) == GetSize(argQ)
	index <SigSpec> port(ff, \Q) === argQ
	filter nusers(port(ff, \Q)) == 2
endmatch

code
	if (clk != SigBit() && sigmap(port(ff, \CLK)[0]) != clk)
		reject;

	for (auto bit : sigmap(port(ff, \Q))) {
		if (!bit.wire)
			continue;
		auto it = bit.wire->attributes.find(\init);
		if (it == bit.wire->attributes.end())
			continue;
		if (bit.offset < GetSize(it->second)) {
			State s = it->second[bit.offset];
			if (s != State::Sx && s != State::S0)
				reject;
		}
	}

	dff = ff;
	dffD = port(ff, \D);
	dffclk = sigmap(port(ff, \CLK)[0]);
endcode

subpattern out_ff
arg argD clk

code
	dff = nullptr;
endcode

match ff
	select ff->type.in($dff, $dffe, $sdff, $sdffe)
	select param(ff, \CLK_POLARITY).as_bool()
	filter ff->type.in($dff, $dffe) || param(ff, \SRST_VALUE).is_fully_zero()
	filter GetSize(port(ff, \D)) == GetSize(argD)
	index <SigSpec> port(ff, \D) === argD
	filter nusers(port(ff, \D)) == 2
endmatch

code
	if (clk != SigBit() && sigmap(port(ff, \CLK)[0]) != clk)
		reject;

	for (auto bit : sigmap(port(ff, \Q))) {
		if (!bit.wire)
			continue;
		auto it = bit.wire->attributes.find(\init);
		if (it == bit.wire->attributes.end())
			continue;
		if (bit.offset < GetSize(it->second)) {
			State s = it->second[bit.offset];
			if (s != State::Sx && s != State::S0)
				reject;
		}
	}

	dff = ff;
	dffQ = port(ff, \Q);
	dffclk = sigmap(port(ff, \CLK)[0]);
endcode
