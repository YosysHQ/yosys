pattern muldiv

state <SigSpec> t x y
state <bool> is_signed x_nonzero

match mul
	select mul->type == $mul
	select GetSize(port(mul, \A)) + GetSize(port(mul, \B)) <= GetSize(port(mul, \Y))
endmatch

code t x y is_signed
	t = port(mul, \Y);
	x = port(mul, \A);
	y = port(mul, \B);
	is_signed = param(mul, \A_SIGNED).as_bool();
	branch;
	std::swap(x, y);
endcode

code x_nonzero
	x_nonzero = x.is_fully_def() && !x.is_fully_zero();
endcode

match div
	select div->type.in($div)
	index <SigSpec> port(div, \A) === t
	index <SigSpec> port(div, \B) === x
	filter param(div, \A_SIGNED).as_bool() == is_signed
	filter param(div, \B_SIGNED).as_bool() == is_signed
	filter x_nonzero || is_signed || GetSize(port(div, \Y)) <= GetSize(t)
endmatch

code
	SigSpec div_y = port(div, \Y);
	SigSpec val_y = y;

	if (GetSize(div_y) != GetSize(val_y))
		val_y.extend_u0(GetSize(div_y), param(div, \A_SIGNED).as_bool());

	did_something = true;
	log("muldiv pattern in %s: mul=%s, div=%s\n", module, mul, div);
	if (x_nonzero) {
		module->connect(div_y, val_y);
	} else {
		SigSpec div_zero = module->LogicNot(NEW_ID, x);
		module->addMux(NEW_ID, val_y, Const(State::S1, GetSize(div_y)), div_zero, div_y);
	}
	autoremove(div);
	accept;
endcode
