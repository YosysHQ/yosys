read_verilog -sv -formal <<EOT
module top (
    input  [3:0] in,
    output [3:0] out
);
    assign out = ~in;

    genvar i;
    generate
        for (i = 0; i < 4; i = i + 1) begin
            always_comb begin
                test_assert:            assert            (in[i] == ~out[i]);
                test_assume:            assume            (in[i] == ~out[i]);
                test_cover:             cover             (in[i] == ~out[i]);
                test_assert_eventually: assert (eventually in[i] == ~out[i]);
                test_assume_eventually: assume (eventually in[i] == ~out[i]);
            end
        end
    endgenerate
endmodule
EOT

select -assert-count 4 c:*test_assert
select -assert-count 4 c:*test_assume
select -assert-count 4 c:*test_cover
select -assert-count 4 c:*test_assert_eventually
select -assert-count 4 c:*test_assume_eventually
