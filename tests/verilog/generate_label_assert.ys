read_verilog -sv <<EOT
module top (
    input  [3:0] in,
    output [3:0] out
);
    assign out = ~in;

    genvar i;
    generate
        for (i = 0; i < 4; i = i + 1) begin
            always_comb begin
                test_i: assert (in[i] == ~out[i]);
                test_z: cover  (in[i] == ~out[i]);
            end
        end
    endgenerate
endmodule
EOT

select -assert-count 4 c:*test_i
select -assert-count 4 c:*test_z
