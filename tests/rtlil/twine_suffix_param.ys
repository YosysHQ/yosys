# Parameter names are leaf twines, Yosys never writes them as suffix twines
logger -expect error "Expected leaf twine for attribute or parameter name, got suffix twine `\\WIDTH'" 1
read_rtlil <<EOT
twines
  leaf 100000 "WID"
  suffix 100001 100000 "TH"
end
module \sub
  wire input 1 \a
end
module \top
  wire input 1 \w
  cell \sub \u
    parameter $pub@100001 4
    connect \a \w
  end
end
EOT
