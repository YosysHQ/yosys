# proc_dlatch walks the mux network driving a latched signal looking for its
# feedback path.  The network is a DAG: here every swap stage reads BOTH
# outputs of the previous stage, so there are 2^32 paths from the outputs back
# to the latched values.  Without memoizing the walk this never finishes
# (each stage doubles the runtime); with it the whole pass is instant.
read_verilog <<EOT
module top(input en, input d0, d1, input [31:0] s, output reg a, b);
integer i;
always @* begin
	if (en) begin a = d0; b = d1; end
	for (i = 0; i < 32; i = i + 1)
		if (s[i]) {a, b} = {b, a};
end
endmodule
EOT
proc
select -assert-count 2 t:$dlatch
