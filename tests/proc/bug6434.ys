# https://github.com/YosysHQ/yosys/issues/6434
read_verilog <<EOT
module test(
	input  wire       ena,
	input  wire [2:0] idx,
	output reg  [7:0] out
);
	always @(*)
	begin : xxx
		integer i;
		if (ena)
			for (i=0; i<8; i=i+1)
				out[i] = i > idx;
		else
			out <= 0;
	end
endmodule
EOT
logger -expect-no-warnings
synth_ice40
logger -check-expected

design -reset

# no latch for an unused loop variable
read_verilog <<EOT
module top(input ena, input [2:0] idx, output reg [7:0] out);
always @* begin : blk
	integer i;
	if (ena)
		for (i = 0; i < 8; i = i + 1)
			out[i] = i > idx;
	else
		out = 0;
end
endmodule
EOT
logger -expect-no-warnings
logger -expect log "No latch inferred for unused signal .*blk\.i" 1
proc -latches error
logger -check-expected
select -assert-none t:$dlatch t:$adlatch
check -assert

design -reset

# latch value read later in the same process is reported
read_verilog <<EOT
module top(input en, d, output reg out);
reg y;
always @* begin
	if (en) y = d;
	out = y;
end
endmodule
EOT
logger -expect warning "Latch inferred for signal" 1
proc -latches warn
logger -check-expected

design -reset
