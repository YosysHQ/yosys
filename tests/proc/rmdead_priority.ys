# https://github.com/YosysHQ/yosys/issues/5839

read_verilog <<EOT
module top(input [31:0] e, output reg [5:0] y, output reg [5:0] ref);
	integer i;
	always @* begin
		ref = 32;
		for (i = 0; i < 32; i = i + 1)
			if (e[i])
				ref = 31 - i;
	end
	always @*
		casez (e)
		32'b00000000000000000000000000000000: y = 32;
		32'b00000000000000000000000000000001: y = 31;
		32'b0000000000000000000000000000001?: y = 30;
		32'b000000000000000000000000000001??: y = 29;
		32'b00000000000000000000000000001???: y = 28;
		32'b0000000000000000000000000001????: y = 27;
		32'b000000000000000000000000001?????: y = 26;
		32'b00000000000000000000000001??????: y = 25;
		32'b0000000000000000000000001???????: y = 24;
		32'b000000000000000000000001????????: y = 23;
		32'b00000000000000000000001?????????: y = 22;
		32'b0000000000000000000001??????????: y = 21;
		32'b000000000000000000001???????????: y = 20;
		32'b00000000000000000001????????????: y = 19;
		32'b0000000000000000001?????????????: y = 18;
		32'b000000000000000001??????????????: y = 17;
		32'b00000000000000001???????????????: y = 16;
		32'b0000000000000001????????????????: y = 15;
		32'b000000000000001?????????????????: y = 14;
		32'b00000000000001??????????????????: y = 13;
		32'b0000000000001???????????????????: y = 12;
		32'b000000000001????????????????????: y = 11;
		32'b00000000001?????????????????????: y = 10;
		32'b0000000001??????????????????????: y = 9;
		32'b000000001???????????????????????: y = 8;
		32'b00000001????????????????????????: y = 7;
		32'b0000001?????????????????????????: y = 6;
		32'b000001??????????????????????????: y = 5;
		32'b00001???????????????????????????: y = 4;
		32'b0001????????????????????????????: y = 3;
		32'b001?????????????????????????????: y = 2;
		32'b01??????????????????????????????: y = 1;
		32'b1???????????????????????????????: y = 0;
		endcase
endmodule
EOT
proc
select -assert-none t:$dlatch
sat -prove y ref -verify
