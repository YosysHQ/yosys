read_verilog <<EOT
module top(input clk, arst, srst, en, d, output reg qa, qs, qb, qt);
always @(posedge clk or posedge arst)
	if (arst) qa <= 1'b0;
	else if (en) qa <= d;
always @(posedge clk)
	if (srst) qs <= 1'b0;
	else if (en) qs <= d;
always @(negedge clk or negedge arst)
	if (!arst) qb <= 1'b1;
	else if (!en) qb <= d;
always @(negedge clk)
	if (!srst) qt <= 1'b1;
	else if (!en) qt <= d;
endmodule
EOT
synth -top top -noabc
opt -fast
design -save gold

design -load gold
abc -clk clk,en,arst
select -assert-count 1 n:$abc$* t:$_*DFF* %i
select -assert-count 1 n:$abc$* t:$_DFFE_PP0P_ %i

design -load gold
abc -clk clk,en,,srst
select -assert-count 1 n:$abc$* t:$_*DFF* %i
select -assert-count 1 n:$abc$* t:$_SDFFE_PP0P_ %i

design -load gold
abc -clk !clk,!en,!arst
select -assert-count 1 n:$abc$* t:$_*DFF* %i
select -assert-count 1 n:$abc$* t:$_DFFE_NN?N_ %i

design -load gold
abc -clk !clk,!en,,!srst
select -assert-count 1 n:$abc$* t:$_*DFF* %i
select -assert-count 1 n:$abc$* t:$_SDFFE_NN?N_ %i
