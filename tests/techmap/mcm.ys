# tests for mcm pass
log -header "MCM normalized A-operation width"
read_verilog <<EOF
module top(
  input  wire [7:0] x,
  output wire [16:0] a,
  output wire [16:0] b,
  output wire [16:0] c
);
  assign a = x * 17'd9;
  assign b = x * 17'd397;
  assign c = x * 17'd505;
endmodule
EOF
equiv_opt -assert mcm
design -load postopt
select -assert-count 0 t:$mul

design -reset

log -header "MCM handles wide coefficients"
read_verilog <<EOF
module top(
  input  wire [7:0] x,
  output wire [47:0] y
);
  assign y = x * 48'h1_0000_0003;
endmodule
EOF
equiv_opt -assert mcm
design -load postopt
select -assert-count 0 t:$mul
select -assert-count 2 t:$add t:$sub

design -reset

log -header "MCM handles very wide coefficients"
read_verilog <<EOF
module top(
  input  wire signed [7:0] x,
  output wire signed [135:0] y
);
  assign y = x * 128'h ffff_ffff_ffff_ffff_ffff_ffff_ffff_fffd;
endmodule
EOF
equiv_opt -assert mcm -max_shift 128
design -load postopt
select -assert-count 0 t:$mul
select -assert-count 2 t:$add t:$sub

design -reset

log -header "MCM prunes dead greedy-search intermediates"
read_verilog <<EOF
module top(
  input  wire [7:0] x,
  output wire [15:0] y
);
  assign y = x * 16'd397;
endmodule
EOF
equiv_opt -assert mcm
design -load postopt
select -assert-count 0 t:$mul
select -assert-max 3 t:$add t:$sub

design -reset

