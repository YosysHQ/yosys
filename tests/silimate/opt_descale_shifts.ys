log -header "Round trip with a zero clamp: the increment becomes a window carry"
log -push
design -reset
read_verilog <<EOF
module top (
  input wire [15:0] x,
  input wire [3:0]  s,
  output wire [15:0] y
);
  wire [16:0] a = x + 1'b1;
  wire [16:0] t = a >> s;
  assign y = (t == 0) ? 16'd0 : t - 1;
endmodule
EOF
prep -top top
check -assert
equiv_opt -assert opt_shift -descale
design -load postopt
# the increment is gone, and the decrement it fed stays
select -assert-count 0 t:$add
select -assert-count 1 t:$sub
# a second shifter selects the window carry out of the AND scan
select -assert-count 2 t:$shr
# ceil(log2(16)) levels of scan, and the carry selects between t and t - 1
select -assert-count 4 t:$and
select -assert-count 2 t:$mux
design -reset
log -pop



log -header "No clamp: a decrement wreduce narrowed still folds, mod 2^k"
log -push
design -reset
read_verilog <<EOF
module top (
  input wire [15:0] x,
  input wire [3:0]  s,
  output wire [15:0] y
);
  wire [16:0] a = x + 1'b1;
  assign y = (a >> s) - 1;
endmodule
EOF
prep -top top
check -assert
equiv_opt -assert opt_shift -descale
design -load postopt
# the decrement reads 16 of the 17 shifted bits, which is the same value mod 2^16
select -assert-count 0 t:$add
select -assert-count 1 t:$sub
select -assert-count 2 t:$shr
select -assert-count 1 t:$mux
design -reset
log -pop



log -header "One-bit source: the AND scan has no levels to build"
log -push
design -reset
read_verilog <<EOF
module top (
  input wire x,
  input wire [3:0] s,
  output wire [1:0] y
);
  wire [1:0] a = x + 1'b1;
  wire [1:0] t = a >> s;
  assign y = (t == 0) ? 2'd0 : t - 1;
endmodule
EOF
prep -top top
check -assert
equiv_opt -assert opt_shift -descale
design -load postopt
# &x[s-1:0] over a single bit is that bit, so the scan is pure wiring
select -assert-count 0 t:$add
select -assert-count 0 t:$and
select -assert-count 2 t:$shr
design -reset
log -pop



log -header "Amount wider than the value: windows past the top carry nothing"
log -push
design -reset
read_verilog <<EOF
module top (
  input wire [7:0] x,
  input wire [7:0] s,
  output wire [7:0] y
);
  wire [8:0] a = x + 1'b1;
  wire [8:0] t = a >> s;
  assign y = (t == 0) ? 8'd0 : t - 1;
endmodule
EOF
prep -top top
check -assert
equiv_opt -assert opt_shift -descale
design -load postopt
# an amount past width(x) reads a zero bit of the scan, so the carry is 0
select -assert-count 0 t:$add
select -assert-count 2 t:$shr
design -reset
log -pop



log -header "Shifter reads the sum zero-extended: hard zeros above it shift to zero"
log -push
design -reset
read_verilog <<EOF
module top (
  input wire [13:0]  w,
  input wire [4:0]   s,
  output wire [15:0] y
);
  wire [16:0] a = {3'd0, w} + 17'd1;
  wire [16:0] t = a >> s;
  assign y = (t == 17'd0) ? 16'd0 : t[15:0] - 16'd1;
endmodule
EOF
hierarchy -check -top top
proc
opt_clean
# Narrow only the increment, to the 14-in/15-out a frontend emits for `w + 1`.
# A full wreduce would also strip the padding off the shifter and hide the shape,
# but nothing widens the sum back, so RTL that declares the shifted word wider
# than the increment needs reaches this pass reading the sum zero-extended.
wreduce t:$add
select -clear
check -assert
equiv_opt -assert opt_shift -descale
design -load postopt
# the two zeros above the sum shift to zeros, so the rescale still holds
select -assert-count 0 t:$add
select -assert-count 1 t:$sub
select -assert-count 2 t:$shr
select -assert-count 2 t:$mux
design -reset
log -pop



log -header "Negative: a live value above the sum is not a zero the shifter can drop"
log -push
design -reset
read_verilog <<EOF
module top (
  input wire [13:0]  w,
  input wire [4:0]   s,
  input wire         hi,
  output wire [15:0] y
);
  wire [14:0] sum = {1'd0, w} + 15'd1;
  wire [16:0] t   = {1'b0, hi, sum} >> s;
  assign y = (t == 17'd0) ? 16'd0 : t[15:0] - 16'd1;
endmodule
EOF
hierarchy -check -top top
proc
opt_clean
wreduce t:$add
select -clear
check -assert
equiv_opt -assert opt_shift -descale
design -load postopt
# rescaling the shifter onto w alone would drop hi, so the round trip stays
select -assert-count 1 t:$add
select -assert-count 1 t:$shr
design -reset
log -pop



log -header "Negative: truncating increment wraps instead of carrying"
log -push
design -reset
read_verilog <<EOF
module top (
  input wire [15:0] x,
  input wire [3:0]  s,
  output wire [15:0] y
);
  wire [15:0] a = x + 1'b1;
  wire [15:0] t = a >> s;
  assign y = (t == 0) ? 16'd0 : t - 1;
endmodule
EOF
prep -top top
check -assert
equiv_opt -assert opt_shift -descale
design -load postopt
# an all-ones x has to carry into bit 16, which this increment does not have
select -assert-count 1 t:$add
select -assert-count 1 t:$shr
design -reset
log -pop



log -header "Negative: the increment is read by something else too"
log -push
design -reset
read_verilog <<EOF
module top (
  input wire [15:0] x,
  input wire [3:0]  s,
  output wire [15:0] y,
  output wire [16:0] esc
);
  wire [16:0] a = x + 1'b1;
  wire [16:0] t = a >> s;
  assign y   = (t == 0) ? 16'd0 : t - 1;
  assign esc = a;
endmodule
EOF
prep -top top
check -assert
equiv_opt -assert opt_shift -descale
design -load postopt
# the rewrite deletes the increment, so it cannot have another reader
select -assert-count 1 t:$add
select -assert-count 1 t:$shr
design -reset
log -pop



log -header "Negative: a reader the window carry cannot fold into"
log -push
design -reset
read_verilog <<EOF
module top (
  input wire [15:0] x,
  input wire [3:0]  s,
  output wire [15:0] y,
  output wire big
);
  wire [16:0] a = x + 1'b1;
  wire [16:0] t = a >> s;
  assign y   = t - 1;
  assign big = t > 17'd100;
endmodule
EOF
prep -top top
check -assert
equiv_opt -assert opt_shift -descale
design -load postopt
# a compare against a limit is not `- 1` or `== 0`, so t has to keep its value
select -assert-count 1 t:$add
select -assert-count 1 t:$shr
design -reset
log -pop



log -header "Negative: a zero test on part of the result can wrap"
log -push
design -reset
read_verilog <<EOF
module top (
  input wire [15:0] x,
  input wire [3:0]  s,
  output wire [15:0] y,
  output wire low0
);
  wire [16:0] a = x + 1'b1;
  wire [16:0] t = a >> s;
  assign y    = t - 1;
  assign low0 = (t[7:0] == 0);
endmodule
EOF
prep -top top
check -assert
equiv_opt -assert opt_shift -descale
design -load postopt
# t[7:0] == 0 is not the same test as {t', c} == 0: the low bits can wrap to
# zero on their own, unlike the full width, where t' + c cannot carry out
select -assert-count 1 t:$add
select -assert-count 1 t:$shr
design -reset
log -pop



log -header "Negative: a decrement outside the selection is not ours to rewrite"
log -push
design -reset
read_verilog <<EOF
module top (
  input wire [15:0] x,
  input wire [3:0]  s,
  output wire [15:0] y
);
  wire [16:0] a = x + 1'b1;
  wire [16:0] t = a >> s;
  assign y = (t == 0) ? 16'd0 : t - 1;
endmodule
EOF
prep -top top
check -assert
# the readers are indexed over the whole module on purpose, so that one left out
# of the selection is seen and refused rather than quietly rewritten
select top/t:$add top/t:$shr
opt_shift -descale
select -assert-count 1 t:$add
select -assert-count 1 t:$shr
design -reset
log -pop



log -header "Negative: a process reads the result and is not in the cell graph"
log -push
design -reset
read_verilog <<EOF
module top (
  input wire clk,
  input wire [15:0] x,
  input wire [3:0]  s,
  output reg [15:0] y,
  output reg [16:0] z
);
  wire [16:0] a = x + 1'b1;
  wire [16:0] t = a >> s;
  always @(posedge clk) begin
    y <= t - 1;
    z <= t;
  end
endmodule
EOF
# no proc, so the always block is still a process, and its `z <= t` reads the
# shifted result without a cell for the walk to find
check -assert
opt_shift -descale
select -assert-count 1 t:$add
select -assert-count 1 t:$shr
design -reset
log -pop



log -header "Negative: constant amount leaves no round trip to break"
log -push
design -reset
read_verilog <<EOF
module top (
  input wire [15:0] x,
  output wire [15:0] y
);
  wire [16:0] a = x + 1'b1;
  assign y = (a >> 3) - 1;
endmodule
EOF
prep -top top
check -assert
equiv_opt -assert opt_shift -descale
design -load postopt
# a constant window is free rewiring, and -combine already folds it
select -assert-count 1 t:$add
design -reset
log -pop



log -header "Negative: signed operands are outside the unsigned identity"
log -push
design -reset
read_verilog <<EOF
module top (
  input wire signed [15:0] x,
  input wire [3:0]         s,
  output wire signed [15:0] y
);
  wire signed [16:0] a = x + 1'sb1;
  wire signed [16:0] t = a >>> s;
  assign y = t - 1;
endmodule
EOF
prep -top top
check -assert
equiv_opt -assert opt_shift -descale
design -load postopt
select -assert-count 1 t:$add
design -reset
log -pop



log -header "Negative: keep on the increment, which the rewrite would delete"
log -push
design -reset
read_verilog <<EOF
module top (
  input wire [15:0] x,
  input wire [3:0]  s,
  output wire [15:0] y
);
  wire [16:0] a = x + 1'b1;
  wire [16:0] t = a >> s;
  assign y = (t == 0) ? 16'd0 : t - 1;
endmodule
EOF
prep -top top
check -assert
setattr -set keep 1 t:$add
opt_shift -descale
select -assert-count 1 t:$add
design -reset
log -pop



log -header "Negative: keep on a reader the rewrite would rewire and rename"
log -push
design -reset
read_verilog <<EOF
module top (
  input wire [15:0] x,
  input wire [3:0]  s,
  output wire [15:0] y
);
  wire [16:0] a = x + 1'b1;
  wire [16:0] t = a >> s;
  assign y = (t == 0) ? 16'd0 : t - 1;
endmodule
EOF
prep -top top
check -assert
setattr -set keep 1 t:$sub
opt_shift -descale
# the carry has nowhere to fold, so the increment stays put
select -assert-count 1 t:$add
select -assert-count 0 c:*_descale
design -reset
log -pop



log -header "Negative: keep on the shifter, which the rewrite rescales and renames"
log -push
design -reset
read_verilog <<EOF
module top (
  input wire [15:0] x,
  input wire [3:0]  s,
  output wire [15:0] y
);
  wire [16:0] a = x + 1'b1;
  wire [16:0] t = a >> s;
  assign y = (t == 0) ? 16'd0 : t - 1;
endmodule
EOF
prep -top top
check -assert
setattr -set keep 1 t:$shr
opt_shift -descale
# no anchor, so nothing folds and the shifter keeps its name and connections
select -assert-count 1 t:$add
select -assert-count 1 t:$shr
select -assert-count 0 c:*_descale
design -reset
log -pop


log -header "Padded sum: the shifter reads the increment zero-extended"
log -push
design -reset
read_verilog <<EOT
module top (
  input wire [13:0] x,
  input wire [4:0]  s,
  output wire [15:0] y
);
  wire [14:0] xp1 = x + 1'b1;
  wire [16:0] a   = {2'b00, xp1} >> s;
  assign y = (a == 0) ? 16'd0 : a[15:0] - 16'd1;
endmodule
EOT
prep -top top
check -assert
equiv_opt -assert opt_shift -descale
design -load postopt
# high zero padding does not change the value, so the round trip still collapses
select -assert-count 0 t:$add
# the shifter, the decrement and the zero test all get renamed for formal
select -assert-count 3 c:*_descale
design -reset
log -pop



log -header "Negative: padding that is not a constant zero"
log -push
design -reset
read_verilog <<EOT
module top (
  input wire [13:0] x,
  input wire [4:0]  s,
  input wire        p,
  output wire [15:0] y
);
  wire [14:0] xp1 = x + 1'b1;
  wire [16:0] a   = {p, 1'b0, xp1} >> s;
  assign y = (a == 0) ? 16'd0 : a[15:0] - 16'd1;
endmodule
EOT
prep -top top
check -assert
equiv_opt -assert opt_shift -descale
design -load postopt
# the pad carries a value of its own, so dropping it would change the shift
select -assert-count 1 t:$add
select -assert-count 0 c:*_descale
design -reset
log -pop
