log -header "-expand-keep-arith: the add tree keeps one barrel, not one per operand"
log -push
design -reset
read_verilog <<EOF
module top (
  input wire [7:0] a,
  input wire [7:0] b,
  input wire [7:0] d,
  input wire [7:0] e,
  input wire [2:0] c,
  output wire [7:0] x
);
  assign x = (a + b + d + e) << c;
endmodule
EOF
