log -header "-expand-keep-arith: bitwise ops are untouched by the guard"
log -push
design -reset
read_verilog <<EOF
module top (
  input wire [7:0] a,
  input wire [7:0] b,
  input wire [2:0] c,
  output wire [7:0] x
);
