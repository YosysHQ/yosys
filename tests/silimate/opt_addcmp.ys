read_verilog -sv <<EOF
module ac(input [15:0] a, input [9:0] b, input [17:0] c, output y, output [17:0] s_out);
  wire [17:0] s = a + b;
  assign y = s >= c;
  assign s_out = s;
endmodule
EOF
proc; opt_clean
