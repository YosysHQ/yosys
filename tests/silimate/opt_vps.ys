log -pop



# =============================================================================
# Test 10: SAT self-equivalence — uniform per-bit gather before vs after
# The gather fold rewrites 82 independent bit-selects into two barrel shifts,
# so prove the assembled words are unchanged before pinning the structure.
# =============================================================================
log -header "SAT self-equivalence: uniform gather before vs after opt_vps"
log -push
design -reset
verific -cfg veri_optimize_wide_selector 1
verific -cfg db_infer_wide_muxes_post_elaboration 0

read -sv opt_vps_gather.sv
verific -import opt_vps_gather
proc; opt_clean
rename opt_vps_gather gold

read -sv opt_vps_gather.sv
verific -import opt_vps_gather
proc; opt_clean
opt_vps; opt_clean
rename opt_vps_gather gate

miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt; memory; opt
clk2fflogic
sat -set-init-zero -tempinduct -prove-asserts -verify
design -reset
log -pop

# =============================================================================
# Test 11: Cell counts — uniform per-bit gather folds to one barrel per group
# Both lane banks read the same table at an index affine in the lane number, so
# each collapses to a single $shr. The $bmux count reaching zero is the point:
# the subtract bank's top lane is the one whose index opt_expr spells as a
# narrow core with a constant-1 MSB extension, and if the affine analysis reads
# that as an unknown sign extension instead of a known addend, that lane lands
# in its own group and survives as a leftover $bmux.
# =============================================================================
log -header "Cell counts: uniform gather post-opt_vps"
log -push
design -reset
verific -cfg veri_optimize_wide_selector 1
verific -cfg db_infer_wide_muxes_post_elaboration 0

read -sv opt_vps_gather.sv
verific -import opt_vps_gather
proc; opt_clean

# The shape that reaches the pass: one $bmux per lane, two banks of 41.
select -assert-count 82 t:$bmux
design -save pregather

opt_vps; opt_clean
select -assert-count 0 t:$bmux
select -assert-count 2 t:$shr

# -min_gather 0 disables the fold, so the same netlist keeps every $bmux. This
# is what keeps the assertions above from passing on a netlist that never had a
# foldable gather in the first place.
design -load pregather
opt_vps -min_gather 0; opt_clean
select -assert-count 82 t:$bmux
select -assert-count 0 t:$shr
design -reset
log -pop

# =============================================================================
# Test 12: zero-fill gather — the other matcher shape, and its wrap guard
# A bank of one-bit-wide right shifts is a gather too: Y[k] = A[B + k] with zero
# fill past the end. Folding it is only sound while an out-of-range index cannot
# alias back into the table, so the same RTL is tested at two index widths.
# read_verilog is used here because Verific elaborates bit-selects to $bmux,
# which takes the other path.
# =============================================================================
log -header "Zero-fill gather: folds when in range, refused when it can alias"
log -push
design -reset
read_verilog -sv <<EOF
module top (
  input  logic [63:0] src,
  input  logic [4:0]  amt,
  output logic [31:0] dst
);
  always_comb begin
    logic [63:0] sh;
    for (int i = 0; i < 32; i++) begin
      sh = src >> (7'(amt) + 7'(i));
      dst[i] = sh[0];
    end
  end
endmodule
EOF
proc; opt_expr; wreduce; opt_clean
select -assert-count 32 t:$shr
equiv_opt -assert opt_vps
design -load postopt
opt_clean
select -assert-max 2 t:$shr
design -reset

# Same gather, but the shift amount is now as wide as the index: amt + 31 wraps
# in 6 bits, so a lane that should read zero would instead alias to the bottom
# of the table. The fold must be refused and every $shr left standing.
read_verilog -sv <<EOF
module top (
  input  logic [63:0] src,
  input  logic [5:0]  amt,
  output logic [31:0] dst
);
  always_comb begin
    logic [63:0] sh;
    for (int i = 0; i < 32; i++) begin
      sh = src >> (amt + 6'(i));
      dst[i] = sh[0];
    end
  end
endmodule
EOF
proc; opt_expr; wreduce; opt_clean
select -assert-count 32 t:$shr
opt_vps; opt_clean
select -assert-count 32 t:$shr
design -reset
log -pop

# =============================================================================
# Test 13: SAT self-equivalence — negative-capable gather index
# -msb-inv-sext rebuilds a value from an uninverted sum, so prove the assembled
# word is unchanged before pinning the structure below.
# =============================================================================
log -header "SAT self-equivalence: negative gather index before vs after opt_vps"
log -push
design -reset
verific -cfg veri_optimize_wide_selector 1
verific -cfg db_infer_wide_muxes_post_elaboration 0

read -sv opt_vps_gather_negidx.sv
verific -import opt_vps_gather_negidx
proc; opt_clean
rename opt_vps_gather_negidx gold

read -sv opt_vps_gather_negidx.sv
verific -import opt_vps_gather_negidx
proc; opt_clean
opt_vps -msb-inv-sext; opt_clean
rename opt_vps_gather_negidx gate

miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt; memory; opt
clk2fflogic
sat -set-init-zero -tempinduct -prove-asserts -verify
design -reset
log -pop

# =============================================================================
# Test 14: Cell counts — the bottom lane only joins the group with the flag
# The lane whose index can go negative is spelled with an inverted MSB. Reading
# that as an unknown sign leaves it in a group of its own, so it survives as a
# second barrel next to the folded one. The default is asserted too, so this
# pins the flag's effect rather than just its result.
# =============================================================================
log -header "Cell counts: negative gather index, with and without -msb-inv-sext"
log -push
design -reset
verific -cfg veri_optimize_wide_selector 1
verific -cfg db_infer_wide_muxes_post_elaboration 0

read -sv opt_vps_gather_negidx.sv
verific -import opt_vps_gather_negidx
proc; opt_clean

select -assert-count 54 t:$shr
design -save pregather_negidx

# Default: 53 of 54 lanes group, and the bottom one is left as its own barrel.
opt_vps; opt_clean
select -assert-count 2 t:$shr

# With the flag all 54 lanes land in one group, so a single barrel remains.
design -load pregather_negidx
opt_vps -msb-inv-sext; opt_clean
select -assert-count 1 t:$shr
design -reset
log -pop

# =============================================================================
# Test 15: SAT self-equivalence — gather over multi-bit elements
# The fold treats a WIDTH=W $bmux as W gathers over strided slices of the table,
# so one cell now lands in W groups and is retired by whichever folds first.
# Prove the assembled words are unchanged before pinning the structure below.
# =============================================================================
log -header "SAT self-equivalence: multi-bit gather before vs after opt_vps"
log -push
design -reset
verific -cfg veri_optimize_wide_selector 1
verific -cfg db_infer_wide_muxes_post_elaboration 0

read -sv opt_vps_gather_wide.sv
verific -import opt_vps_gather_wide
proc; opt_clean
rename opt_vps_gather_wide gold

read -sv opt_vps_gather_wide.sv
verific -import opt_vps_gather_wide
proc; opt_clean
opt_vps; opt_clean
rename opt_vps_gather_wide gate

miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt; memory; opt
sat -prove-asserts -verify
design -reset
log -pop

# =============================================================================
# Test 16: Cell counts — multi-bit gather folds to one barrel per element bit
# Two banks of 8 lanes read a 16-entry table of 4-bit elements, giving 16 WIDTH=4
# $bmux. Folding is per element bit, so the result is 4 barrels per bank and no
# $bmux left. Before the width generalization every one of these was skipped.
# =============================================================================
log -header "Cell counts: multi-bit gather post-opt_vps"
log -push
design -reset
verific -cfg veri_optimize_wide_selector 1
verific -cfg db_infer_wide_muxes_post_elaboration 0

read -sv opt_vps_gather_wide.sv
verific -import opt_vps_gather_wide
proc; opt_clean

select -assert-count 16 t:$bmux
design -save pregather_wide

opt_vps; opt_clean
select -assert-count 0 t:$bmux
select -assert-count 8 t:$shr

# -min_gather 0 disables the fold, so every $bmux survives. This keeps the
# assertions above from passing on a netlist that had nothing foldable.
design -load pregather_wide
opt_vps -min_gather 0; opt_clean
select -assert-count 16 t:$bmux
select -assert-count 0 t:$shr
design -reset
log -pop
