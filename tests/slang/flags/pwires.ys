verilog_default:
design -reset
read_verilog <<EOF
module top #(parameter P = 3) (output [3:0] q);
  assign q = P;
endmodule
EOF
select -assert-none w:P

verilog_flag:
design -reset
read_verilog -pwires <<EOF
module top #(parameter P = 3) (output [3:0] q);
  assign q = P;
endmodule
EOF
select -assert-count 1 w:P

slang_default:
design -reset
read_slang <<EOF
module top #(parameter P = 3) (output [3:0] q);
  assign q = P;
endmodule
EOF
select -assert-none w:P

slang_flag:
design -reset
read_slang --pwires <<EOF
module top #(parameter P = 3) (output [3:0] q);
  assign q = P;
endmodule
EOF
select -assert-count 1 w:P
