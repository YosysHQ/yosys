verilog_default:
design -reset
read_verilog <<EOF
module top(input a);
`ifdef FORMAL
  always @* assert(a);
`endif
endmodule
EOF
select -assert-none r:FLAVOR=assert

verilog_flag:
design -reset
read_verilog -formal <<EOF
module top(input a);
`ifdef FORMAL
  always @* assert(a);
`endif
endmodule
EOF
select -assert-count 1 r:FLAVOR=assert

slang_default:
design -reset
read_slang <<EOF
module top(input a);
`ifdef FORMAL
  always @* assert(a);
`endif
endmodule
EOF
select -assert-none r:FLAVOR=assert

slang_flag:
design -reset
# TODO: -formal; require the flagged read_verilog behavior.
read_slang --formal <<EOF
module top(input a);
`ifdef FORMAL
  always @* assert(a);
`endif
endmodule
EOF
select -assert-count 1 r:FLAVOR=assert
