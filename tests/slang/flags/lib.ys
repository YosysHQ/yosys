verilog_default:
design -reset
read_verilog <<EOF
module top(input a, output q);
  assign q = ~a;
endmodule
EOF
select -assert-count 1 top/t:$not

verilog_flag:
design -reset
read_verilog -lib <<EOF
module top(input a, output q);
  assign q = ~a;
endmodule
EOF
select -assert-any =A:blackbox
select -assert-none =top/t:$not

slang_default:
design -reset
read_slang <<EOF
module top(input a, output q);
  assign q = ~a;
endmodule
EOF
select -assert-count 1 top/t:$not

slang_flag:
design -reset
read_slang --lib <<EOF
module top(input a, output q);
  assign q = ~a;
endmodule
EOF
select -assert-any =A:blackbox
select -assert-none =top/t:$not
