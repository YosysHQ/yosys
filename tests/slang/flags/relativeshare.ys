verilog_default:
design -reset
read_verilog -lib +/adff2dff.v
tee -o relativeshare.tmp dump =adff2dff
exec -q -expect-return 0 -not-expect-stdout [+]\/adff2dff.v: -- cat relativeshare.tmp

verilog_flag:
design -reset
read_verilog -lib -relativeshare +/adff2dff.v
tee -o relativeshare.tmp dump =adff2dff
exec -q -expect-return 0 -expect-stdout [+]\/adff2dff.v: -- cat relativeshare.tmp

slang_default:
design -reset
read_slang ../../../techlibs/common/adff2dff.v
tee -o relativeshare.tmp dump =adff2dff
exec -q -expect-return 0 -not-expect-stdout [+]\/adff2dff.v: -- cat relativeshare.tmp

slang_flag:
design -reset
# TODO: -relativeshare; require the same relative source attribute.
read_slang ../../../techlibs/common/adff2dff.v
tee -o relativeshare.tmp dump =adff2dff
exec -q -expect-return 0 -expect-stdout [+]\/adff2dff.v: -- cat relativeshare.tmp
