verilog_default:
design -reset
read_verilog -formal <<EOF
module top(input a);
  always @* begin
    assert(a);
    assume(a);
    cover(a);
  end
endmodule
EOF
select -assert-count 1 r:FLAVOR=assert
select -assert-count 1 r:FLAVOR=assume
select -assert-count 1 r:FLAVOR=cover

verilog_flag:
design -reset
read_verilog -formal -noassume <<EOF
module top(input a);
  always @* begin
    assert(a);
    assume(a);
    cover(a);
  end
endmodule
EOF
select -assert-count 1 r:FLAVOR=assert
select -assert-count 0 r:FLAVOR=assume
select -assert-count 1 r:FLAVOR=cover

slang_default:
design -reset
read_slang <<EOF
module top(input a);
  always @* begin
    assert(a);
    assume(a);
    cover(a);
  end
endmodule
EOF
opt_clean
select -assert-count 1 r:FLAVOR=assert
select -assert-count 1 r:FLAVOR=assume
select -assert-count 1 r:FLAVOR=cover

slang_flag:
design -reset
read_slang --noassume <<EOF
module top(input a);
  always @* begin
    assert(a);
    assume(a);
    cover(a);
  end
endmodule
EOF
opt_clean
select -assert-count 1 r:FLAVOR=assert
select -assert-count 0 r:FLAVOR=assume
select -assert-count 1 r:FLAVOR=cover
