verilog_default:
design -reset
read_verilog -sv <<EOF
module top(output q);
  import "DPI-C" function int f();
  assign q = 1'b0;
endmodule
EOF

slang_default:
design -reset
read_slang <<EOF
module top(output q);
  import "DPI-C" function int f();
  assign q = 1'b0;
endmodule
EOF

slang_flag:
design -reset
# TODO: -nodpi; this call should reject the DPI import.
logger -expect error "Found DPI function" 1
read_slang <<EOF
module top(output q);
  import "DPI-C" function int f();
  assign q = 1'b0;
endmodule
EOF

logger -check-expected

# Run this error reference separately with: script nodpi.ys verilog_flag
verilog_flag:
design -reset
logger -expect error "Found DPI function" 1
read_verilog -sv -nodpi <<EOF
module top(output q);
  import "DPI-C" function int f();
  assign q = 1'b0;
endmodule
EOF
