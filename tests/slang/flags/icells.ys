verilog_default:
design -reset
read_verilog <<EOF
(* blackbox *)
module \$not #(parameter A_SIGNED = 0, A_WIDTH = 1, Y_WIDTH = 1)
  (input [A_WIDTH-1:0] A, output [Y_WIDTH-1:0] Y);
endmodule
module top(input a, output q);
  \$not #(.A_SIGNED(0), .A_WIDTH(1), .Y_WIDTH(1)) inv (.A(a), .Y(q));
endmodule
EOF
select -assert-count 1 top/t:\\$not

verilog_flag:
design -reset
read_verilog -icells <<EOF
(* blackbox *)
module \$not #(parameter A_SIGNED = 0, A_WIDTH = 1, Y_WIDTH = 1)
  (input [A_WIDTH-1:0] A, output [Y_WIDTH-1:0] Y);
endmodule
module top(input a, output q);
  \$not #(.A_SIGNED(0), .A_WIDTH(1), .Y_WIDTH(1)) inv (.A(a), .Y(q));
endmodule
EOF
select -assert-none top/t:\\$not
select -assert-count 1 top/t:$not

slang_default:
design -reset
read_slang --top top <<EOF
(* blackbox *)
module \$not #(parameter A_SIGNED = 0, A_WIDTH = 1, Y_WIDTH = 1)
  (input [A_WIDTH-1:0] A, output [Y_WIDTH-1:0] Y);
endmodule
module top(input a, output q);
  \$not #(.A_SIGNED(0), .A_WIDTH(1), .Y_WIDTH(1)) inv (.A(a), .Y(q));
endmodule
EOF
select -assert-count 1 top/t:\\$not

slang_flag:
design -reset
read_slang --icells --top top <<EOF
(* blackbox *)
module \$not #(parameter A_SIGNED = 0, A_WIDTH = 1, Y_WIDTH = 1)
  (input [A_WIDTH-1:0] A, output [Y_WIDTH-1:0] Y);
endmodule
module top(input a, output q);
  \$not #(.A_SIGNED(0), .A_WIDTH(1), .Y_WIDTH(1)) inv (.A(a), .Y(q));
endmodule
EOF
select -assert-none top/t:\\$not
select -assert-count 1 top/t:$not
