# ============================== TDP RAM ==============================
# RAM bits <= 18K; Data width <= 18x2; Address width <= 9: -> DP16KD

design -reset
read_slang --best-effort-hierarchy --allow-use-before-declare --no-proc --ignore-timing --std latest --top sync_ram_tdp -G ADDRESS_WIDTH=9 -G DATA_WIDTH=18 ../common/blockram.v
proc
opt_clean
hierarchy -top sync_ram_tdp
synth_ecp5 -top sync_ram_tdp; cd sync_ram_tdp
select -assert-count 1 t:DP16KD
select -assert-none t:LUT4
