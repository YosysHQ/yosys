read_slang --allow-use-before-declare --ignore-timing --std latest  spram.v
opt_clean
hierarchy -top top
synth_ice40
select -assert-count 1 t:SB_SPRAM256KA
select -assert-none t:SB_SPRAM256KA %% t:* %D

