design -reset
read_slang <<EOT
module top (clk, a, b, c, d);
	input clk;

	(* anyseq *)
    output wire a;
    (* anyconst *)
    output wire b;
    (* allseq *)
    output wire c;
    (* allconst *)
    output wire d;
endmodule
EOT
opt_clean
stat
write_rtlil

select -assert-count 1 t:$anyseq
select -assert-count 1 t:$anyconst
select -assert-count 1 t:$allseq
select -assert-count 1 t:$allconst
select -assert-count 4 c:*
