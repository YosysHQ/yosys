# Regression for sv-elab#402: all readers must share the same undriven value.
design -reset
read_slang --undriven-as-anyseq --top top <<EOT
module child(input logic clk, input logic rst, input logic [5:0] x, input [5:0] y);
    always @(posedge clk)
        if (!rst) begin : x_range_a
            assert(x < 43);
            assert(y < 43);
        end
endmodule

module top(input logic clk, input logic rst);
    logic [5:0] x;
    wire  [5:0] y;
    always @(posedge clk)
        if (!rst) begin : x_range_m
            assume(x < 43);
            assume(y < 43);
        end
    child c0(.clk, .rst, .x, .y);
    child c1(.clk, .rst, .x, .y);
endmodule
EOT

prep -top top
async2sync
chformal -lower
opt_clean

select -assert-count 2 t:$lt
sat -verify -seq 2 -set rst 0 -set-init-zero -set-assumes -prove-asserts
