read_slang --std latest <<EOT
module top(input i, output o, output y);
	sub s(.i(i), .o(o));
	bb #(.P(1)) b(.a('0), .y(y));
endmodule

module sub(input i, output o);
	assign o = ~i;
endmodule

(* blackbox *)
module bb #(parameter P = 0) (input a, output y);
endmodule
EOT
opt_clean
hierarchy -top top
flatten
abc9 -lut 4
hierarchy -check
