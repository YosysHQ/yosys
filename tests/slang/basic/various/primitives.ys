read_slang --std latest <<EOT
module top(input a, b, output [5:0] y);
and (y[0], a, b);
nand (y[1], a, b);
or (y[2], a, b);
nor (y[3], a, b);
xor (y[4], a, b);
xnor (y[5], a, b);
endmodule
EOT
opt_clean
select -assert-count 1 t:$and a:src=<inlined>:2.5 %i
select -assert-count 1 t:$and a:src=<inlined>:3.6 %i
select -assert-count 1 t:$or a:src=<inlined>:4.4 %i
select -assert-count 1 t:$or a:src=<inlined>:5.5 %i
select -assert-count 1 t:$xor a:src=<inlined>:6.5 %i
select -assert-count 1 t:$xnor a:src=<inlined>:7.6 %i
