read_slang --std latest <<EOT
module sub #(parameter d=1) (input in, output out);
    assign out = in;
endmodule
EOT
opt_clean

read_slang --std latest <<EOT
module top();
    wire array[0:0];
    wire out;
    sub #(.d(1)) inst(
        .in(array[0]),
        .out(out)
    );
endmodule
EOT
opt_clean

hierarchy -top top
