# abc_new before dfflibmap: $_DFF_PN0_ stay as boundary cells
read_liberty -lib ../openroad/sm_test_cells.lib
read_verilog spm.v
hierarchy -top spm -chparam bits 8
proc
flatten
opt
design -save gold

synth -run fine:
select -assert-count 16 t:$_DFF_PN0_
abc_new -liberty ../openroad/cm_test_cells.lib
select -assert-count 16 t:$_DFF_PN0_
select -assert-none t:$_*_ t:$_DFF_PN0_ %d
dfflibmap -liberty ../openroad/sm_test_cells.lib
opt_clean
select -assert-count 16 t:DFFR
select -assert-none t:$_*_
check -assert

read_verilog ../openroad/cells_sim.v
proc
flatten
opt_clean
design -stash gate
design -copy-from gold -as gold spm
design -copy-from gate -as gate spm
async2sync
equiv_make gold gate equiv
equiv_simple -seq 5
equiv_induct -seq 5
equiv_status -assert
