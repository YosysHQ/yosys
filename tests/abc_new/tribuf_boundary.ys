# $_TBUF_ stay as boundary cells
read_verilog <<EOT
module top(input en, input [3:0] a, b, output [3:0] y, inout [3:0] io);
	assign y = en ? a & b : 4'bz;
	assign io = en ? a : 4'bz;
endmodule
EOT

hierarchy -top top
proc
opt
tribuf
techmap
select -assert-count 8 t:$_TBUF_
abc_new -liberty openroad/cm_test_cells.lib
select -assert-count 8 t:$_TBUF_
select -assert-none t:$_*_ t:$_TBUF_ %d
check -assert
