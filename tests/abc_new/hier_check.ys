# $input_port cells left in the submodule, check fails until opt_clean
read_verilog <<EOT
module sub(input a, b, c, output y);
	assign y = (a & b) | c;
endmodule
module top(input a, b, c, d, output y, z);
	assign z = (a ^ b) & d;
	sub s_i (.a(a), .b(b), .c(c), .y(y));
endmodule
EOT

hierarchy -top top
techmap
abc_new -liberty openroad/cm_test_cells.lib
select -assert-none t:$input_port
check -assert
