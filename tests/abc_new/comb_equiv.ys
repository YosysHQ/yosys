# comb logic maps fully and stays equivalent
read_verilog <<EOT
module top(input [3:0] a, b, input s, c, output [4:0] y, output z, output k);
	assign y = s ? a + b : a - b;
	assign z = (a == b) ^ c;
	assign k = 1'b1;
endmodule
EOT

hierarchy -top top
proc
opt
design -save gold

techmap
opt
abc_new -liberty openroad/cm_test_cells.lib
select -assert-none t:$_*_
select -assert-min 20 t:*
check -assert

read_verilog openroad/cells_sim.v
flatten
opt_clean
design -stash gate
design -copy-from gold -as gold top
design -copy-from gate -as gate top
miter -equiv -flatten -make_assert gold gate miter
sat -verify -prove-asserts -show-ports miter
