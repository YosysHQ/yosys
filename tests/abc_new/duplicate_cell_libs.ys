# https://github.com/YosysHQ/yosys/issues/4977

# abc names the duplicated cell before it asserts, which used to be lost in a
# stdio buffer that the abort never flushed
logger -expect log "There are two standard cells with the same name" 1
logger -expect error "ABC" 1
read_verilog <<EOT
module top(input a, b, output y);
	assign y = ~(a & b);
endmodule
EOT

hierarchy -top top
techmap

libcache -scl -disable
abc_new -liberty openroad/cm_test_cells.lib -liberty dup_inv.lib
