read_verilog -formal -sv <<EOT
module top(input clk, enabled);
    logic gated_clk;
    reg [2:0] count = 0;

    always_latch
        if (enabled)
            gated_clk = clk;

    always @(posedge gated_clk)
        count <= count + 1'b1;

    always @* assert (count <= 2);
endmodule
EOT

proc
select -assert-count 1 t:$dlatch
select -assert-count 1 t:$check
prep -formal -top top
select -assert-none t:$dlatch t:$adlatch t:$dlatchsr
select -assert-count 1 t:$assert
select -assert-none t:$check
check -assert
