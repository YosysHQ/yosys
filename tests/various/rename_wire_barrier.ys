# a cell that drives a barrier cut takes the wire name after the barrier, a barrier on a load changes nothing
read_rtlil <<EOT
module \top
  wire input 1 \a
  wire input 2 \b
  wire output 3 \y
  wire \n
  wire $cut
  wire $q
  cell $_AND_ $and
    connect \A \a
    connect \B \b
    connect \Y \n
  end
  cell $barrier $load
    parameter \WIDTH 1
    connect \A \n
    connect \Y $cut
  end
  cell $_NOT_ $not
    connect \A $cut
    connect \Y $q
  end
  cell $barrier $driver
    parameter \WIDTH 1
    connect \A $q
    connect \Y \y
  end
end
EOT
rename -wire -suffix _c t:$_AND_ t:$_NOT_
select -assert-count 1 c:n_c t:$_AND_ %i
select -assert-count 1 c:y_c t:$_NOT_ %i
design -reset

# both barriers of a chain derive y$barrier, the second keeps its own name because y$barrier is in use
read_rtlil <<EOT
module \top
  wire input 1 \a
  wire $p
  wire output 2 \y
  cell $barrier $b1
    parameter \WIDTH 1
    connect \A \a
    connect \Y $p
  end
  cell $barrier $b2
    parameter \WIDTH 1
    connect \A $p
    connect \Y \y
  end
end
EOT
rename -wire
select -assert-count 1 c:y$barrier
select -assert-count 1 c:$b1 c:$b2
design -reset

read_rtlil <<EOT
module \top
  wire input 1 \a
  wire input 2 \b
  wire output 3 \n
  wire \n_c
  cell $_AND_ $and
    connect \A \a
    connect \B \b
    connect \Y \n
  end
end
EOT
rename -wire -suffix _c t:$_AND_
select -assert-count 1 c:$and
