equiv_status -assert equiv

design -reset
read_verilog -icells <<EOF
module sm2(input wire [1:0] a, output wire [1:0] y);
	assign y = a + 1;
endmodule

module sm1(input wire [2:0] a, output wire [2:0] y);
	sm2 inst(a[1:0], y[2:1]);
	assign y[0] = !a[2];
endmodule

module top(input wire [4:0] a, output wire [4:0] y);
	sm1 i1(.a(a[2:0]), .y(y[2:0]));
	sm2 i2(.a(a[4:3]), .y(y[4:3]));
endmodule
EOF

prep -top top
# deal with arithmetic which is unsupported inside aiger2
techmap t:$add

splitnets -ports top
opt_clean
write_aiger2 -flatten aiger2_flatten.aig
flatten
rename top gold
read_aiger -module_name gate aiger2_flatten.aig
miter -equiv -flatten gold gate miter
sat -verify -prove trigger 0 miter

design -reset
read_verilog -icells <<EOF
module test();

`define BIOP(name,op,w1,w2,wy) \
wire [w1-1:0] name``_a1; \
wire [w2-1:0] name``_b1; \
wire [wy-1:0] name``_y1; \
assign name``_y1 = name``_a1 op name``_b1; \
wire signed [w1-1:0] name``_a2; \
wire signed [w2-1:0] name``_b2; \
wire [wy-1:0] name``_y2; \
assign name``_y2 = name``_a2 op name``_b2;

`BIOP(shl, <<, 3, 6, 6)
`BIOP(shr, >>, 6, 6, 3)
`BIOP(sshl, <<<, 3, 6, 6)
`BIOP(sshr, >>>, 6, 6, 3)
`BIOP(eqx, ===, 3, 4, 1)
`BIOP(nex, !==, 3, 4, 1)
`BIOP(mul, *, 3, 4, 6)
`BIOP(mul_trunc, *, 4, 4, 3)

wire [5:0] shift1_a; wire [3:0] shift1_b; wire [2:0] shift1_y;
\$shift #(.A_SIGNED(0), .B_SIGNED(0), .A_WIDTH(6), .B_WIDTH(4), .Y_WIDTH(3)) shift1 (.A(shift1_a), .B(shift1_b), .Y(shift1_y));
wire [2:0] shift2_a; wire [3:0] shift2_b; wire [5:0] shift2_y;
\$shift #(.A_SIGNED(1), .B_SIGNED(0), .A_WIDTH(3), .B_WIDTH(4), .Y_WIDTH(6)) shift2 (.A(shift2_a), .B(shift2_b), .Y(shift2_y));
wire [5:0] shift3_a; wire [6:0] shift3_b; wire [2:0] shift3_y;
\$shift #(.A_SIGNED(0), .B_SIGNED(1), .A_WIDTH(6), .B_WIDTH(7), .Y_WIDTH(3)) shift3 (.A(shift3_a), .B(shift3_b), .Y(shift3_y));
wire [2:0] shift4_a; wire [6:0] shift4_b; wire [5:0] shift4_y;
\$shift #(.A_SIGNED(1), .B_SIGNED(1), .A_WIDTH(3), .B_WIDTH(7), .Y_WIDTH(6)) shift4 (.A(shift4_a), .B(shift4_b), .Y(shift4_y));
endmodule
EOF

