read_verilog -sv <<EOT
module top(
    output [7:0] a0, a1, a2, a3, a4, a5,
    output [7:0] b0, b1, b2, b3, b4, b5,
    output [3:0] c00, c01, c10, c11,
    output [3:0] d00, d01, d10, d11,
    output [3:0] e00, e01, e10, e11,
    output [3:0] f00, f01, f10, f11
);
    logic [7:0] a [0:5];
    logic [7:0] b [5:0];
    logic [3:0] c [0:1][0:1];
    logic [3:0] d [0:1][1:0];
    logic [3:0] e [1:0][0:1];
    logic [3:0] f [1:0][1:0];

    initial begin
        a = '{8'd1 + 8'd2, 4 << 1, -3, 2**3, 1 ? 8'h5a : 8'ha5, 2.5};
        b = '{8'd1 + 8'd2, 4 << 1, -3, 2**3, 1 ? 8'h5a : 8'ha5, 2.5};
        c = '{'{4'hf & 4'h3, {2'b10, 2'b01}}, '{{2{2'b11}}, ~4'd1}};
        d = '{'{4'hf & 4'h3, {2'b10, 2'b01}}, '{{2{2'b11}}, ~4'd1}};
        e = '{'{4'hf & 4'h3, {2'b10, 2'b01}}, '{{2{2'b11}}, ~4'd1}};
        f = '{'{4'hf & 4'h3, {2'b10, 2'b01}}, '{{2{2'b11}}, ~4'd1}};
    end

    assign {a0, a1, a2, a3, a4, a5} = {a[0], a[1], a[2], a[3], a[4], a[5]};
    assign {b0, b1, b2, b3, b4, b5} = {b[0], b[1], b[2], b[3], b[4], b[5]};
    assign {c00, c01, c10, c11} = {c[0][0], c[0][1], c[1][0], c[1][1]};
    assign {d00, d01, d10, d11} = {d[0][0], d[0][1], d[1][0], d[1][1]};
    assign {e00, e01, e10, e11} = {e[0][0], e[0][1], e[1][0], e[1][1]};
    assign {f00, f01, f10, f11} = {f[0][0], f[0][1], f[1][0], f[1][1]};
endmodule
EOT
proc
memory
opt -full
dump
sat -verify -prove a0 8'd3 -prove a1 8'd8 -prove a2 8'hfd -prove a3 8'd8 -prove a4 8'h5a -prove a5 8'd3
sat -verify -prove b5 8'd3 -prove b4 8'd8 -prove b3 8'hfd -prove b2 8'd8 -prove b1 8'h5a -prove b0 8'd3
sat -verify -prove c00 4'h3 -prove c01 4'b1001 -prove c10 4'hf -prove c11 4'he
sat -verify -prove d01 4'h3 -prove d00 4'b1001 -prove d11 4'hf -prove d10 4'he
sat -verify -prove e10 4'h3 -prove e11 4'b1001 -prove e00 4'hf -prove e01 4'he
sat -verify -prove f11 4'h3 -prove f10 4'b1001 -prove f01 4'hf -prove f00 4'he
