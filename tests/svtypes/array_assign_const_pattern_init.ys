read_verilog -sv <<EOT
module top(
    output [7:0] a0, a1, a2, a3, a4, a5,
    output [3:0] b00, b01, b10, b11
);
    logic [7:0] a [6];
    logic [3:0] b [2][2];

    initial begin
        a = '{8'd1 + 8'd2, 4 << 1, -3, 2**3, 1 ? 8'h5a : 8'ha5, 2.5};
        b = '{'{4'hf & 4'h3, {2'b10, 2'b01}}, '{{2{2'b11}}, ~4'd1}};
    end

    assign {a0, a1, a2, a3, a4, a5} = {a[0], a[1], a[2], a[3], a[4], a[5]};
    assign {b00, b01, b10, b11} = {b[0][0], b[0][1], b[1][0], b[1][1]};
endmodule
EOT
proc
select -assert-count 2 t:$meminit_v2
select -assert-none w:$assignpattern$*
memory
opt -full
sat -verify -prove a0 8'd3 -prove a1 8'd8 -prove a2 8'hfd -prove a3 8'd8 -prove a4 8'h5a -prove a5 8'd3
sat -verify -prove b00 4'h3 -prove b01 4'b1001 -prove b10 4'hf -prove b11 4'he
