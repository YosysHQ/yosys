# Tests for opt_modadd_tree
#
# Each group exercises a specific facet:
#   A: associative tree (emit shape 1) combined by a proven const table.
#   B: associative tree combined by a clone of the cascade's own step.
#   C: transfer-function tree (emit shape 2) on a step that is NOT associative.
#   D: rejection guards -- wrong fixup constant, state too wide, clone budget.
#   E: the depth guards, which keep the shape off shallow cascades.
#   F: the ripple and narrow-state guards, which keep it off boolean chains.
#
# Depth is the point of this pass, so the structural checks are `ltp -noff`
# lengths rather than cell counts: the tree trades area for depth, so cell
# counts go UP even when the rewrite is a large win.

# ============================================================================
# Group A: associative tree, const-table combiner
# ============================================================================

# A1: mod-9 digit sum over 40 bits. The 4-bit accumulator never truncates, so
# (acc + d) mod 9 really is associative and the cheap shape applies.
log -header "A1: mod-9 digit sum (equiv)"
log -push
design -reset
read_verilog -sv <<EOF
module top (input wire [39:0] a, output wire [3:0] y);
  function automatic [3:0] f (input [39:0] v);
    integer i; reg [3:0] acc;
    begin
      acc = 4'd0;
      for (i = 0; i < 13; i = i + 1) begin
        acc = acc + {1'b0, v[i*3 +: 3]};
        if (acc >= 4'd9) acc = acc - 4'd9;
      end
      acc = acc + {3'b0, v[39]};
      if (acc >= 4'd9) acc = acc - 4'd9;
      f = acc;
    end
  endfunction
  assign y = f(a);
endmodule
EOF
proc
opt_expr
opt_clean
check -assert
# equiv_opt alone would also pass if the pass stopped firing, so require the
# rewrite too. Same for the other equiv groups below.
logger -expect log "Rewrote 1 associative cascade\(s\) as balanced tree\(s\), 0 cascade\(s\) as transfer-function tree\(s\)" 1
equiv_opt -assert opt_modadd_tree
logger -check-expected
design -load postopt
design -reset
log -pop

# A2: same design, structural. The serial chain is 41 cells deep; the tree is
# 8. Partial results are single 4-bit states, so there is exactly one combiner
# per merge (13 for 14 leaves) -- the transfer-function shape would instead
# need one lookup per state per merge.
log -header "A2: mod-9 digit sum (structural)"
log -push
design -reset
read_verilog -sv <<EOF
module top (input wire [39:0] a, output wire [3:0] y);
  function automatic [3:0] f (input [39:0] v);
    integer i; reg [3:0] acc;
    begin
      acc = 4'd0;
      for (i = 0; i < 13; i = i + 1) begin
        acc = acc + {1'b0, v[i*3 +: 3]};
        if (acc >= 4'd9) acc = acc - 4'd9;
      end
      acc = acc + {3'b0, v[39]};
      if (acc >= 4'd9) acc = acc - 4'd9;
      f = acc;
    end
  endfunction
  assign y = f(a);
endmodule
EOF
proc
opt_expr
opt_clean
select -assert-count 0 t:$bmux
logger -expect log "length=41\)" 1
ltp -noff
logger -check-expected
logger -expect log "Rewrote 1 associative cascade\(s\) as balanced tree\(s\), 0 cascade\(s\) as transfer-function tree\(s\)" 1
opt_modadd_tree
logger -check-expected
clean -purge
select -assert-count 13 t:$bmux
logger -expect log "length=8\)" 1
ltp -noff
logger -check-expected
design -reset
log -pop

# ============================================================================
# Group B: associative tree, step-logic combiner
# ============================================================================

# B1: 4-bit wrapping accumulator, i.e. modulus 2**4, so the digit is as wide
# as the state and a bare $add already computes the proven combine table. The
# tree is then built from clones of that $add and emits no lookup at all.
log -header "B1: 4-bit wrapping accumulator, step used as combiner (equiv)"
log -push
design -reset
read_verilog -sv <<EOF
module top (input wire [63:0] a, output wire [3:0] y);
  function automatic [3:0] f (input [63:0] v);
    integer i; reg [3:0] acc;
    begin
      acc = 4'd0;
      for (i = 0; i < 16; i = i + 1)
        acc = acc + v[i*4 +: 4];
      f = acc;
    end
  endfunction
  assign y = f(a);
endmodule
EOF
proc
opt_expr
opt_clean
check -assert
logger -expect log "Rewrote 1 associative cascade\(s\) as balanced tree\(s\), 0 cascade\(s\) as transfer-function tree\(s\)" 1
equiv_opt -assert opt_modadd_tree
logger -check-expected
design -load postopt
design -reset
log -pop

# B2: same design, structural. Confirm the combiner really is the cloned step
# (no $bmux anywhere) and that the depth dropped.
log -header "B2: step-logic combiner (structural)"
log -push
design -reset
read_verilog -sv <<EOF
module top (input wire [63:0] a, output wire [3:0] y);
  function automatic [3:0] f (input [63:0] v);
    integer i; reg [3:0] acc;
    begin
      acc = 4'd0;
      for (i = 0; i < 16; i = i + 1)
        acc = acc + v[i*4 +: 4];
      f = acc;
    end
  endfunction
  assign y = f(a);
endmodule
EOF
proc
opt_expr
opt_clean
logger -expect log "length=15\)" 1
ltp -noff
logger -check-expected
logger -expect log "reusing step logic as combiner" 1
logger -expect log "Rewrote 1 associative cascade\(s\) as balanced tree\(s\), 0 cascade\(s\) as transfer-function tree\(s\)" 1
debug opt_modadd_tree
logger -check-expected
clean -purge
# The whole tree is cloned adds; a lookup would mean the table shape was used.
select -assert-count 0 t:$bmux
select -assert-count 22 t:$add
select -assert-min 1 c:*modadd*
logger -expect log "length=7\)" 1
ltp -noff
logger -check-expected
design -reset
log -pop

# ============================================================================
# Group C: transfer-function tree on a non-associative step
# ============================================================================

# C1: mod-7 digit sum with a 3-bit accumulator. The add truncates, so the step
# is NOT associative -- 7+7 wraps to 5, not 6, hence (x.y).z != x.(y.z) -- and
# the const-table shape would be unsound. The proof must reject it and the
# general shape must run instead. equiv_opt is what makes this load-bearing:
# if a future edit lets the cheap shape through here, equivalence fails.
log -header "C1: truncating mod-7 digit sum (equiv)"
log -push
design -reset
read_verilog -sv <<EOF
module top (input wire [39:0] a, output wire [2:0] y);
  function automatic [2:0] f (input [39:0] v);
    integer i; reg [2:0] acc;
    begin
      acc = 3'd0;
      for (i = 0; i < 13; i = i + 1) begin
        acc = acc + v[i*3 +: 3];
        if (acc >= 3'd7) acc = acc - 3'd7;
      end
      acc = acc + {2'b0, v[39]};
      if (acc >= 3'd7) acc = acc - 3'd7;
      f = acc;
    end
  endfunction
  assign y = f(a);
endmodule
EOF
proc
opt_expr
opt_clean
check -assert
logger -expect log "Rewrote 0 associative cascade\(s\) as balanced tree\(s\), 1 cascade\(s\) as transfer-function tree\(s\)" 1
equiv_opt -assert opt_modadd_tree
logger -check-expected
design -load postopt
design -reset
log -pop

# C2: same design, structural. Pin that the associative tier was refused (and
# why), that the general tier ran, and that depth collapsed anyway.
log -header "C2: truncating mod-7 digit sum (structural)"
log -push
design -reset
read_verilog -sv <<EOF
module top (input wire [39:0] a, output wire [2:0] y);
  function automatic [2:0] f (input [39:0] v);
    integer i; reg [2:0] acc;
    begin
      acc = 3'd0;
      for (i = 0; i < 13; i = i + 1) begin
        acc = acc + v[i*3 +: 3];
        if (acc >= 3'd7) acc = acc - 3'd7;
      end
      acc = acc + {2'b0, v[39]};
      if (acc >= 3'd7) acc = acc - 3'd7;
      f = acc;
    end
  endfunction
  assign y = f(a);
endmodule
EOF
proc
opt_expr
opt_clean
logger -expect log "length=41\)" 1
ltp -noff
logger -check-expected
# Composing two steps is not itself a step, which is exactly why the cheap
# shape is unsound here. This pins that the proof reached a verdict on every
# grouping tried, not that it tried six; retune the count when the grouping
# schedule changes. Soundness is pinned by the rewrite counts below.
logger -expect log "distinct step function" 6
logger -expect log "Rewrote 0 associative cascade\(s\) as balanced tree\(s\), 1 cascade\(s\) as transfer-function tree\(s\)" 1
debug opt_modadd_tree
logger -check-expected
clean -purge
# One lookup per state per merge, so far more than the 13 the cheap shape
# would emit. This is the shape difference, not just a size difference.
select -assert-min 40 t:$bmux
logger -expect log "length=7\)" 1
ltp -noff
logger -check-expected
design -reset
log -pop

# ============================================================================
# Group D: rejection guards
# ============================================================================

# D1: compares against 7 but subtracts 5, so the step is not mod-M addition
# and is not associative for a different reason than C. The const-table shape
# must be refused here too.
log -header "D1: fixup constant != compare constant -> cheap shape refused"
log -push
design -reset
read_verilog -sv <<EOF
module top (input wire [39:0] a, output wire [2:0] y);
  function automatic [2:0] f (input [39:0] v);
    integer i; reg [2:0] acc;
    begin
      acc = 3'd0;
      for (i = 0; i < 13; i = i + 1) begin
        acc = acc + v[i*3 +: 3];
        if (acc >= 3'd7) acc = acc - 3'd5;
      end
      acc = acc + {2'b0, v[39]};
      if (acc >= 3'd7) acc = acc - 3'd5;
      f = acc;
    end
  endfunction
  assign y = f(a);
endmodule
EOF
proc
opt_expr
opt_clean
check -assert
logger -expect log "Rewrote 0 associative cascade\(s\) as balanced tree\(s\), 1 cascade\(s\) as transfer-function tree\(s\)" 1
opt_modadd_tree
logger -check-expected
design -reset
log -pop

# D2: same cascade shape but mod 61, so the accumulator needs 6 bits and
# carrying the transfer map would replicate the step 2**6 times. At the
# default budgets the state-width limit refuses it outright.
log -header "D2: 6-bit state -> refused by the state-width budget"
log -push
design -reset
read_verilog -sv <<EOF
module top (input wire [39:0] a, output wire [5:0] y);
  function automatic [5:0] f (input [39:0] v);
    integer i; reg [5:0] acc;
    begin
      acc = 6'd0;
      for (i = 0; i < 13; i = i + 1) begin
        acc = acc + {3'b0, v[i*3 +: 3]};
        if (acc >= 6'd61) acc = acc - 6'd61;
      end
      acc = acc + {5'b0, v[39]};
      if (acc >= 6'd61) acc = acc - 6'd61;
      f = acc;
    end
  endfunction
  assign y = f(a);
endmodule
EOF
proc
opt_expr
opt_clean
select -assert-count 55 t:*
design -save mod61
logger -expect log "Rewrote 0 associative cascade\(s\) as balanced tree\(s\), 0 cascade\(s\) as transfer-function tree\(s\)" 1
opt_modadd_tree
logger -check-expected
select -assert-count 0 c:*modadd*
select -assert-count 55 t:*
log -pop

# D3: raise only the width budget. The cascade now matches, so the clone
# budget is what has to stop it -- 3264 copies of the step against a 1024
# budget.
log -header "D3: 6-bit state -> refused by the clone budget"
log -push
design -load mod61
logger -expect log "3264 clone\(s\) exceeds budget 1024" 1
logger -expect log "Rewrote 0 associative cascade\(s\) as balanced tree\(s\), 0 cascade\(s\) as transfer-function tree\(s\)" 1
debug opt_modadd_tree -max-state-bits 6
logger -check-expected
select -assert-count 0 c:*modadd*
select -assert-count 55 t:*
log -pop

# D4: raising both budgets does rewrite it, so D2 and D3 are refusals by the
# guards rather than a failure to match in the first place.
log -header "D4: 6-bit state rewrites once the budgets allow it"
log -push
design -load mod61
logger -expect log "Rewrote 0 associative cascade\(s\) as balanced tree\(s\), 1 cascade\(s\) as transfer-function tree\(s\)" 1
opt_modadd_tree -max-state-bits 6 -max-clones 100000
logger -check-expected
select -assert-min 1 c:*modadd*
design -reset
log -pop

# ============================================================================
# Group E: depth guards
# ============================================================================

# E1: only four digits, so the serial chain is shallow and replicating the
# step would buy a level or two at best. Short narrow-state cascades like this
# are everywhere in real designs, so the guards must leave them alone. The
# depth floor gets there first, before the chain is even grouped.
log -header "E1: shallow cascade -> left alone"
log -push
design -reset
read_verilog -sv <<EOF
module top (input wire [11:0] a, output wire [2:0] y);
  function automatic [2:0] f (input [11:0] v);
    integer i; reg [2:0] acc;
    begin
      acc = 3'd0;
      for (i = 0; i < 4; i = i + 1) begin
        acc = acc + v[i*3 +: 3];
        if (acc >= 3'd7) acc = acc - 3'd7;
      end
      f = acc;
    end
  endfunction
  assign y = f(a);
endmodule
EOF
proc
opt_expr
opt_clean
select -assert-count 15 t:*
design -save shallow
logger -expect log "skipping cascade at .*serial depth at most 22, below 32" 1
logger -expect log "Rewrote 0 associative cascade\(s\) as balanced tree\(s\), 0 cascade\(s\) as transfer-function tree\(s\)" 1
debug opt_modadd_tree
logger -check-expected
select -assert-count 0 c:*modadd*
select -assert-count 15 t:*
log -pop

# E1b: drop the floor below the chain and the ratio guard is what refuses it,
# which is the check that actually compares the two shapes. Keep both covered:
# the floor is a cheap pre-filter, this is the real depth-win call.
log -header "E1b: shallow cascade -> refused by the depth-win ratio"
log -push
design -load shallow
logger -expect log "skipping general cascade at .*serial depth 21 vs tree depth 13" 1
logger -expect log "Rewrote 0 associative cascade\(s\) as balanced tree\(s\), 0 cascade\(s\) as transfer-function tree\(s\)" 1
debug opt_modadd_tree -min-serial-depth 8
logger -check-expected
select -assert-count 0 c:*modadd*
select -assert-count 15 t:*
log -pop

# E2: the same cascade rewrites once both depth thresholds are lowered, so E1
# and E1b are guards declining a real match rather than the pass failing to
# see it.
log -header "E2: shallow cascade rewrites once the thresholds allow it"
log -push
design -load shallow
logger -expect log "Rewrote 0 associative cascade\(s\) as balanced tree\(s\), 1 cascade\(s\) as transfer-function tree\(s\)" 1
opt_modadd_tree -min-serial-depth 8 -min-depth-gain 1
logger -check-expected
select -assert-min 1 c:*modadd*
design -reset
log -pop

# ============================================================================
# Group F: ripple and narrow-state guards
# ============================================================================

# F1: a flag threaded through eight compare steps. The state is one bit, so
# the transfer-function shape would clone each compare cone twice to carry a
# map that tree balancing gets for free -- on a real FPU this shape cost 17x
# area for no depth. Two independent cost guards refuse it; the ripple guard
# gets there first, because the adds and compares feed the addend and the
# state itself only ever passes through a $not, an $and and a $mux.
log -header "F1: bitwise step -> left alone"
log -push
design -reset
read_verilog -sv <<EOF
module top (input wire [127:0] a, input wire [15:0] k, output wire y);
  function automatic f (input [127:0] v, input [15:0] kk);
    integer i; reg acc; reg [15:0] t;
    begin
      acc = 1'b0;
      for (i = 0; i < 8; i = i + 1) begin
        t = v[i*16 +: 16] + kk;
        if (t > kk)
          acc = ~acc;
        else
          acc = acc & t[0];
      end
      f = acc;
    end
  endfunction
  assign y = f(a, k);
endmodule
EOF
proc
opt_expr
opt_clean
check -assert
design -save flag
# Every prefix of the chain is its own candidate, so pin the full-length one
# rather than counting all sixteen skips.
logger -expect log "skipping cascade at .y: step ripple depth 1 below 2" 1
logger -expect log "Rewrote 0 associative cascade\(s\) as balanced tree\(s\), 0 cascade\(s\) as transfer-function tree\(s\)" 1
debug opt_modadd_tree
logger -check-expected
select -assert-count 0 c:*modadd*
log -pop

# F1b: relax the ripple guard and the width guard refuses the same chain, so
# both are still load-bearing on their own. The floor comes down too because
# the state path here is only fifteen levels of gates -- the adds that make
# the cone look deep are addend logic the rewrite never touches.
log -header "F1b: one-bit state -> left alone by the width guard"
log -push
design -load flag
logger -expect log "skipping general cascade at .y: state width 1 below 2" 1
logger -expect log "Rewrote 0 associative cascade\(s\) as balanced tree\(s\), 0 cascade\(s\) as transfer-function tree\(s\)" 1
debug opt_modadd_tree -min-ripple-depth 1 -min-serial-depth 8
logger -check-expected
select -assert-count 0 c:*modadd*
log -pop

# F2: the same cascade rewrites once each of those cost guards is told to
# stand down, so F1 and F1b are refusals to pay rather than failures to match.
log -header "F2: one-bit state rewrites once the cost guards allow it"
log -push
design -load flag
logger -expect log "Rewrote 0 associative cascade\(s\) as balanced tree\(s\), 1 cascade\(s\) as transfer-function tree\(s\)" 1
opt_modadd_tree -min-state-bits 1 -min-ripple-depth 1 -min-serial-depth 8
logger -check-expected
select -assert-min 1 c:*modadd*
design -reset
log -pop

# F3: those guards are cost calls, not correctness ones, so prove the rewrite
# they decline. Same flag chain narrowed to 4-bit steps, which keeps the
# equivalence check cheap; the thresholds come down to match the shorter chain.
log -header "F3: the declined one-bit rewrite is equivalent"
log -push
design -reset
read_verilog -sv <<EOF
module top (input wire [23:0] a, input wire [3:0] k, output wire y);
  function automatic f (input [23:0] v, input [3:0] kk);
    integer i; reg acc; reg [3:0] t;
    begin
      acc = 1'b0;
      for (i = 0; i < 6; i = i + 1) begin
        t = v[i*4 +: 4] + kk;
        if (t > kk)
          acc = ~acc;
        else
          acc = acc & t[0];
      end
      f = acc;
    end
  endfunction
  assign y = f(a, k);
endmodule
EOF
proc
opt_expr
opt_clean
check -assert
logger -expect log "Rewrote 0 associative cascade\(s\) as balanced tree\(s\), 1 cascade\(s\) as transfer-function tree\(s\)" 1
equiv_opt -assert opt_modadd_tree -min-state-bits 1 -min-ripple-depth 1 -min-serial-depth 8 -min-depth-gain 1
logger -check-expected
design -load postopt
select -assert-min 1 c:*modadd*
design -reset
log -pop
