# RR7: DIFFERENT RTL SPELLING of the same rotated-priority function. Instead of
# the customer's downward idx-- last-write-wins loop, scan UPWARD from s+1 with
# wraparound and keep the FIRST hit. This is a functionally identical arbiter
# written in an unrelated style; detection is functional so it must still fire
# and prove equivalent. (Combinational, pointer `s` an input -> full equiv at
# power-of-2 N over all pointer values.)
log -header "RR7: upward-scan spelling variant, N=16 (equiv + fires)"
log -push
design -reset
read_verilog -sv <<EOF
module test #(parameter int N=16, parameter int W=4) (
  input  logic [N-1:0] req, input logic [W-1:0] s,
  output logic [W-1:0] grant
);
  always_comb begin
    logic [W-1:0] idx; logic found;
    grant='0; found=1'b0;
    for (int k=1;k<=N;k++) begin
      idx = W'((s + k) % N);
      if (req[idx] && !found) begin grant = idx; found = 1'b1; end
    end
  end
endmodule
EOF
hierarchy -top test
proc
opt
equiv_opt -assert opt_prienc
design -load postopt
select -assert-min 1 w:*rr*
design -reset
log -pop

# RR8: negative -- FIXED-priority arbiter (constant start, no rotating pointer).
# This is a plain priority encoder, not a round-robin, so no round_robin
# rewrite may fire (it may still be picked up by the ordinary PE/CTZ path,
# which is fine; we only forbid a spurious *rr* rewrite).
log -header "RR8: fixed-priority (no pointer) -> no round-robin rewrite"
log -push
design -reset
read_verilog -sv <<EOF
module test #(parameter int N=13, parameter int W=4) (
  input  logic [N-1:0] req,
  output logic [W-1:0] grant
);
  always_comb begin
    logic [W-1:0] idx; grant='0;
    for (int i=0;i<N;i++) begin
      idx = W'(N-1-i);
      if (req[idx]) grant=idx;   // last-write-wins over a fixed 0..N-1 order
    end
  end
endmodule
EOF
hierarchy -top test
proc
opt
opt_prienc
select -assert-count 0 w:*rr*
design -reset
log -pop

# ============================================================================
# Group G: large-N sampling paths (PE one-hots + RR starts)
# ============================================================================
#
# These lock the sub-quadratic fingerprint schedules used for N>32 (PE) and
# N>16 (RR starts). Full SAT equiv at these widths is expensive, so we check
# detection + structural collapse only.

# G1: plain 64-bit CLZ for-loop -- sampled PE one-hot deck must still detect.
log -header "G1: plain 64-bit CLZ (large-N PE sample path)"
log -push
design -reset
read_verilog -sv <<EOF
module top (
  input  logic [63:0] x,
  output logic [6:0]  y
);
  always_comb begin
    logic done;
    y    = 7'd64;
    done = 1'b0;
    for (int i = 0; i < 64; i++) begin
      if (!done && x[63 - i]) begin
        y    = i[6:0];
        done = 1'b1;
      end
    end
  end
endmodule
EOF
proc
check -assert
opt_prienc -max-width 64
clean -purge
select -assert-count 63 t:$mux
select -assert-count 0 t:$sub
design -reset
log -pop

# G2: RR DEPTH=64 -- sampled start pointers (N>16) must still detect grant.
log -header "G2: round-robin DEPTH=64 (large-N RR sample path)"
log -push
design -reset
read_verilog -sv <<EOF
module test #(parameter int DEPTH = 64) (
    input  logic                    clk,
    input  logic                    rst_n,
    input  logic [DEPTH-1:0]        req,
    output logic [$clog2(DEPTH)-1:0] grant
);
    typedef logic [$clog2(DEPTH)-1:0] idx_t;
    idx_t idx, idx_next, idx_last;
    always_comb begin
        idx = idx_last; idx_next = idx_last; grant = '0;
        for (int i = 0; i < DEPTH; i++) begin
            if (req[idx]) begin grant = idx; idx_next = idx; end
            if (idx == 0) idx = idx_t'(DEPTH-1); else idx--;
        end
    end
    always_ff @(posedge clk) begin
        if (!rst_n) idx_last <= '0;
        else if (idx_last != idx_next) idx_last <= idx_next;
    end
endmodule
EOF
hierarchy -top test
proc
opt
opt_prienc
# grant is rewritten via the sampled-start RR fingerprint; idx_next may remain
# on very deep unrolled cones. Detection of at least one rr_* network is enough
# to lock the N>16 start-sampling path.
select -assert-min 1 w:*rr*
design -reset
log -pop

# ============================================================================
# Group M: mask-domain consumers wider than the input
# ============================================================================
#
# W > N with a saturating count is the corner where the thermometer mask and
# the one-hot have to agree at position N itself: for N=8 the count reaches 8,
# so mask = (1<<8)-1 = 16'h00ff and one-hot = 16'h0100, whose set bit sits at
# the first position the prefix no longer covers.

# M1: N=8 input feeding 16-bit align-down / align-up / one-hot consumers.
log -header "M1: W > N saturating mask and one-hot (equiv)"
log -push
design -reset
read_verilog -sv <<EOF
module top (
  input  logic [7:0]  x,
  input  logic [15:0] a,
  output logic [15:0] y_down,
  output logic [15:0] y_up,
  output logic [15:0] y_onehot
);
  logic [3:0] cnt;
  always_comb begin
    logic done;
    cnt  = 4'd8;
    done = 1'b0;
    for (int i = 0; i < 8; i++) begin
      if (!done && x[7 - i]) begin
        cnt  = i[3:0];
        done = 1'b1;
      end
    end
  end
  assign y_down   = (a >> cnt) << cnt;
  assign y_up     = ((a >> cnt) + 16'd1) << cnt;
  assign y_onehot = 16'h1 << cnt;
endmodule
EOF
proc
check -assert
# Covers every (x, a), so x == 0 -- where cnt saturates at 8 -- is included.
equiv_opt -assert opt_prienc
design -load postopt
# Both barrel shifters and the binary encoder leave the netlist: that is what
# staying in the mask domain buys, and it is what fails if the collapse stops
# firing.
select -assert-count 0 t:$shl
select -assert-count 0 t:$shr
select -assert-count 0 t:$mux
design -reset
log -pop

# M2: pin the values at the saturating point itself, so a mask or one-hot that
# is off by one position at i == N fails here rather than only under equiv.
log -header "M2: W > N saturating values at x == 0"
log -push
design -reset
read_verilog -sv <<EOF
module top (
  input  logic [7:0]  x,
  input  logic [15:0] a,
  output logic [15:0] y_down,
  output logic [15:0] y_up,
  output logic [15:0] y_onehot
);
  logic [3:0] cnt;
  always_comb begin
    logic done;
    cnt  = 4'd8;
    done = 1'b0;
    for (int i = 0; i < 8; i++) begin
      if (!done && x[7 - i]) begin
        cnt  = i[3:0];
        done = 1'b1;
      end
    end
  end
  assign y_down   = (a >> cnt) << cnt;
  assign y_up     = ((a >> cnt) + 16'd1) << cnt;
  assign y_onehot = 16'h1 << cnt;
endmodule
EOF
proc
opt_prienc
sat -verify -set x 8'h00 -set a 16'hbeef \
    -prove y_down 16'hbe00 -prove y_up 16'hbf00 -prove y_onehot 16'h0100
design -reset
log -pop

# ============================================================================
# Group N: runs of ones, not just runs of zeros
# ============================================================================

# N1: count trailing ones. Same casez ladder as A3 with the polarity flipped,
# so the run being measured is of ones and the network has to invert the input
# before the leading-bit search. The variant name is pinned because the rewrite
# would still be equivalent -- and the group would still pass -- if the pass
# fell back to treating this as a plain priority encoder.
log -header "N1: 8-bit count-trailing-ones via casez (cto_full)"
log -push
design -reset
read_verilog <<EOF
module top (
  input wire [7:0] x,
  output reg [3:0] y
);
  always @* begin
    casez (x)
      8'b???????0: y = 4'd0;
      8'b??????01: y = 4'd1;
      8'b?????011: y = 4'd2;
      8'b????0111: y = 4'd3;
      8'b???01111: y = 4'd4;
      8'b??011111: y = 4'd5;
      8'b?0111111: y = 4'd6;
      8'b01111111: y = 4'd7;
      default:      y = 4'd8;
    endcase
  end
endmodule
EOF
proc
check -assert
logger -expect log "y <- cto_full\(x\) \[N=8, W=4\]" 1
equiv_opt -assert opt_prienc
logger -check-expected
design -load postopt
design -reset
log -pop

# N2: count leading ones at 16 bits, via the same for-loop-with-break idiom as
# A4 with the bit test negated: the loop stops at the first zero from the top.
log -header "N2: 16-bit count-leading-ones via for-loop (clo_full)"
log -push
design -reset
read_verilog -sv <<EOF
module top (
  input  logic [15:0] x,
  output logic [4:0]  y
);
  always_comb begin
    logic done;
    y = 5'd16;
    done = 1'b0;
    for (int i = 0; i < 16; i++) begin
      if (!done && !x[15 - i]) begin
        y    = i[4:0];
        done = 1'b1;
      end
    end
  end
endmodule
EOF
proc
check -assert
logger -expect log "<- clo_full\(x\) \[N=16, W=5\]" 1
equiv_opt -assert opt_prienc
logger -check-expected
design -load postopt
design -reset
log -pop

# ============================================================================
# Group S: smear (MSB suffix-OR) identities, gated on -smear
# ============================================================================

# S1: cto_full(smear(x)) collapses to msb_index(x)+1.
log -header "S1: smear feeding trailing-ones encoder (-smear)"
log -push
design -reset
read_verilog <<EOF
module top (
  input wire [7:0] x,
  output reg [3:0] y
);
  integer i;
  reg [7:0] m;
  always @* begin
    m = 8'b0;
    for (i = 7; i >= 0; i = i - 1)
      m[i] = |x[7:i];
    casez (m)
      8'b11111111: y = 4'd8;
      8'b01111111: y = 4'd7;
      8'b?0111111: y = 4'd6;
      8'b??011111: y = 4'd5;
      8'b???01111: y = 4'd4;
      8'b????0111: y = 4'd3;
      8'b?????011: y = 4'd2;
      8'b??????01: y = 4'd1;
      8'b???????0: y = 4'd0;
      default:    y = 4'bx;
    endcase
  end
endmodule
EOF
proc
check -assert
logger -expect log "suffix-or" 1
logger -expect log "Collapsed 1 smear/encoder round-trip" 1
equiv_opt -assert opt_prienc -smear
logger -check-expected
design -reset
log -pop

# S2: without -smear the encoder still matches, but the smear round-trip does not.
log -header "S2: smear feeding encoder, flag off"
log -push
design -reset
read_verilog <<EOF
module top (
  input wire [7:0] x,
  output reg [3:0] y
);
  integer i;
  reg [7:0] m;
  always @* begin
    m = 8'b0;
    for (i = 7; i >= 0; i = i - 1)
      m[i] = |x[7:i];
    casez (m)
      8'b11111111: y = 4'd8;
      8'b01111111: y = 4'd7;
      8'b?0111111: y = 4'd6;
      8'b??011111: y = 4'd5;
      8'b???01111: y = 4'd4;
      8'b????0111: y = 4'd3;
      8'b?????011: y = 4'd2;
      8'b??????01: y = 4'd1;
      8'b???????0: y = 4'd0;
      default:    y = 4'bx;
    endcase
  end
endmodule
EOF
proc
check -assert
logger -expect log "y <- cto_full" 1
equiv_opt -assert opt_prienc
logger -check-expected
design -reset
log -pop

# S3: smear(x) < K (K a port, hence off-path) narrows into the encoded domain.
log -header "S3: smear compared against an off-path operand"
log -push
design -reset
read_verilog <<EOF
module top (
  input  wire [7:0] x,
  input  wire [7:0] k,
  output wire       y
);
  wire [7:0] m;
  genvar i;
  generate
    for (i = 0; i < 8; i = i + 1)
      assign m[i] = |x[7:i];
  endgenerate
  assign y = m < k;
endmodule
EOF
proc
check -assert
logger -expect log "via smear narrowed" 1
equiv_opt -assert opt_prienc -smear
logger -check-expected
design -reset
log -pop

# S4: combinational other operand must not be narrowed.
log -header "S4: smear compared against a combinational operand (negative)"
log -push
design -reset
read_verilog <<EOF
module top (
  input  wire [7:0] x,
  input  wire [7:0] a,
  input  wire [7:0] b,
  output wire       y
);
  wire [7:0] m;
  genvar i;
  generate
    for (i = 0; i < 8; i = i + 1)
      assign m[i] = |x[7:i];
  endgenerate
  assign y = m < (a + b);
endmodule
EOF
proc
check -assert
logger -expect log "narrowed 0 compare" 1
opt_prienc -smear
logger -check-expected
design -reset
log -pop

# S5: a bus one bit off from a suffix-OR must not fingerprint as a smear.
log -header "S5: near-miss smear (negative)"
log -push
design -reset
read_verilog <<EOF
module top (
  input  wire [7:0] x,
  output reg  [3:0] y
);
  wire [7:0] m;
  assign m[7] = x[7];
  assign m[6] = |x[7:6];
  assign m[5] = |x[7:5];
  assign m[4] = |x[7:4];
  assign m[3] = |x[7:3];
  assign m[2] = x[2];
  assign m[1] = |x[7:1];
  assign m[0] = |x[7:0];
  integer i;
  always @* begin
    casez (m)
      8'b11111111: y = 4'd8;
      8'b01111111: y = 4'd7;
      8'b?0111111: y = 4'd6;
      8'b??011111: y = 4'd5;
      8'b???01111: y = 4'd4;
      8'b????0111: y = 4'd3;
      8'b?????011: y = 4'd2;
      8'b??????01: y = 4'd1;
      8'b???????0: y = 4'd0;
      default:    y = 4'bx;
    endcase
  end
endmodule
EOF
proc
check -assert
logger -expect log "y <- cto_full" 1
logger -expect log "Collapsed 0 smear/encoder round-trip" 1
equiv_opt -assert opt_prienc -smear
logger -check-expected
design -reset
log -pop

# S6: smear behind a pad mux still collapses on the smear arm.
log -header "S6: smear behind a mux, encoder on the mux output"
log -push
design -reset
read_verilog <<EOF
module top (
  input wire [7:0] x,
  input wire       en,
  output reg [3:0] y
);
  integer i;
  reg [7:0] m, t;
  always @* begin
    m = 8'b0;
    for (i = 7; i >= 0; i = i - 1)
      m[i] = |x[7:i];
    t = en ? m : x;
    casez (t)
      8'b11111111: y = 4'd8;
      8'b01111111: y = 4'd7;
      8'b?0111111: y = 4'd6;
      8'b??011111: y = 4'd5;
      8'b???01111: y = 4'd4;
      8'b????0111: y = 4'd3;
      8'b?????011: y = 4'd2;
      8'b??????01: y = 4'd1;
      8'b???????0: y = 4'd0;
      default:    y = 4'bx;
    endcase
  end
endmodule
EOF
proc
check -assert
logger -expect log "suffix-or" 1
logger -expect log "Collapsed 1 smear/encoder round-trip" 1
equiv_opt -assert opt_prienc -smear
logger -check-expected
design -reset
log -pop
