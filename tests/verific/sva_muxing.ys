verific -sv << EOT
module top (input clk, en, a, b);
    always @(posedge clk) if (en) assert property (a ##1 b);
endmodule
EOT
verific -import top
select -assert-any t:$assert %ci* i:a %i
select -assert-any t:$assert %ci* i:en %i

design -reset
verific -sv << EOT
module top (input clk, rst, en, a);
    always @(posedge clk) if (en) assert property (disable iff (rst) a);
endmodule
EOT
verific -import top
select -assert-any t:$assert %ci* i:a %i
select -assert-any t:$assert %ci* i:en %i

design -reset
verific -sv << EOT
module top (input clk, en, a);
    assert property (@(posedge clk iff en) a);
endmodule
EOT
verific -import top
select -assert-any t:$assert %ci* i:a %i
select -assert-any t:$assert %ci* i:en %i

design -reset
verific -sv << EOT
module top (input clk, en, a, b);
    always @(posedge clk) if (en) cover property (a ##1 b);
endmodule
EOT
verific -import top
select -assert-any t:$cover %ci* i:a %i
select -assert-any t:$cover %ci* i:en %i

design -reset
verific -sv << EOT
module top (input clk, rst, en, a);
    always @(posedge clk) if (en) cover property (disable iff (rst) a);
endmodule
EOT
verific -import top
select -assert-any t:$cover %ci* i:a %i
select -assert-any t:$cover %ci* i:en %i

design -reset
verific -sv << EOT
module top (input clk, en, a);
    always @(posedge clk iff en) cover property (a);
endmodule
EOT
verific -import top
select -assert-any t:$cover %ci* i:a %i
select -assert-any t:$cover %ci* i:en %i

design -reset
verific -sv << EOT
module top (input clk, en, a);
    cover property (@(posedge clk iff en) a);
endmodule
EOT
verific -import top
select -assert-any t:$cover %ci* i:a %i
select -assert-any t:$cover %ci* i:en %i

design -reset
verific -sv << EOT
module top (input clk, ce, en, rst, a);
    always @(posedge clk iff ce) if (en) cover property (disable iff (rst) a);
endmodule
EOT
verific -import top
select -assert-any t:$cover %ci* i:a %i
select -assert-any t:$cover %ci* i:en %i
select -assert-any t:$cover %ci* i:rst %i
select -assert-any t:$cover %ci* i:clk %i
select -assert-any t:$cover %ci* i:ce %i
