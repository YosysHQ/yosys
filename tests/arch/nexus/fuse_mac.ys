read_verilog -sv fuse_mac.sv

design -save pristine

# 18x18 MAC
design -load pristine
hierarchy -top mac;
synth_nexus -family lifcl -top mac
select -assert-count 1 t:MULTADDSUB18X18
select -assert-count 0 t:CCU2

design -load pristine
hierarchy -top mac;
synth_nexus -family lifcl -top mac -run begin:map_ram
check -assert

# 18x18 pre-add MAC
design -load pristine
hierarchy -top madd_pre;
synth_nexus -family lifcl -top madd_pre
select -assert-count 1 t:MULTPREADD18X18

# 4-lane 9x9 dot product
design -load pristine
hierarchy -top dot4;
synth_nexus -family lifcl -top dot4
select -assert-count 1 t:MULTADDSUB9X9WIDE

# 24x24 MAC
design -load pristine
hierarchy -top mac24;
synth_nexus -family lifcl -top mac24
select -assert-count 0 t:MULTADDSUB18X18
select -assert-count 1 t:MULTADDSUB36X36

# mixed
design -load pristine
hierarchy -top neg_dot_mixed;
synth_nexus -family lifcl -top neg_dot_mixed
select -assert-count 0 t:MULTADDSUB9X9WIDE
select -assert-count 2 t:MULTADDSUB18X18

# 36x36 MAC
design -load pristine
hierarchy -top mac36;
synth_nexus -family lifcl -top mac36
select -assert-count 1 t:MULTADDSUB36X36
select -assert-count 0 t:CCU2

# 36x36 C - A*B
design -load pristine
hierarchy -top msub36;
synth_nexus -family lifcl -top msub36
select -assert-count 1 t:MULTADDSUB36X36
select -assert-count 0 t:CCU2

# A*B - C is not a DSP operation
design -load pristine
hierarchy -top neg_mulsub36;
synth_nexus -family lifcl -top neg_mulsub36
select -assert-count 0 t:MULTADDSUB36X36

# 16x16 MAC with a 52-bit sum stays on the 18x18 cell
design -load pristine
hierarchy -top mac16;
synth_nexus -family lifcl -top mac16
select -assert-count 1 t:MULTADDSUB18X18
select -assert-count 0 t:MULTADDSUB36X36

# 4-lane 9x9 dot product with addend
design -load pristine
hierarchy -top dot4_acc;
synth_nexus -family lifcl -top dot4_acc
select -assert-count 1 t:MULTADDSUB9X9WIDE
select -assert-count 0 t:CCU2

# Cells read elsewhere must not be removed
design -load pristine
hierarchy -top mac_sel;
proc
equiv_opt -assert -map +/lattice/cells_sim_nexus.v synth_nexus -family lifcl -top mac_sel -run begin:map_ram

design -load pristine
hierarchy -top preadd_fanout;
proc
equiv_opt -assert -map +/lattice/cells_sim_nexus.v synth_nexus -family lifcl -top preadd_fanout -run begin:map_ram

design -load pristine
hierarchy -top mul_reg_fanout;
proc
equiv_opt -assert -map +/lattice/cells_sim_nexus.v synth_nexus -family lifcl -top mul_reg_fanout -run begin:map_ram
