read_verilog  ../common/mux.v
design -save read

design -load read
hierarchy -top mux2
proc
equiv_opt -assert -async2sync -map +/cyclone2/cells_sim.v synth_cyclone2 -noiopad # equivalency check
design -load postopt # load the post-opt design (otherwise equiv_opt loads the pre-opt design)
cd mux2 # Constrain all select calls below inside the top module
select -assert-max 1 t:LCELL_COMB
select -assert-none t:LCELL_COMB %% t:* %D

design -load read
hierarchy -top mux4
proc
equiv_opt -assert -async2sync -map +/cyclone2/cells_sim.v synth_cyclone2 -noiopad # equivalency check
design -load postopt # load the post-opt design (otherwise equiv_opt loads the pre-opt design)
cd mux4 # Constrain all select calls below inside the top module
select -assert-max 2 t:LCELL_COMB
select -assert-none t:LCELL_COMB %% t:* %D

design -load read
hierarchy -top mux8
proc
equiv_opt -assert -async2sync -map +/cyclone2/cells_sim.v synth_cyclone2 -noiopad # equivalency check
design -load postopt # load the post-opt design (otherwise equiv_opt loads the pre-opt design)
cd mux8 # Constrain all select calls below inside the top module
select -assert-max 5 t:LCELL_COMB
select -assert-none t:LCELL_COMB %% t:* %D

design -load read
hierarchy -top mux16
proc
equiv_opt -assert -async2sync -map +/cyclone2/cells_sim.v synth_cyclone2 -noiopad # equivalency check
design -load postopt # load the post-opt design (otherwise equiv_opt loads the pre-opt design)
cd mux16 # Constrain all select calls below inside the top module
select -assert-max 12 t:LCELL_COMB
select -assert-none t:LCELL_COMB %% t:* %D
