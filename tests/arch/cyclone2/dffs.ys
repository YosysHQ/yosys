read_verilog -D NO_INIT ../common/dffs.v
design -save read

design -load read
hierarchy -top dff
proc
equiv_opt -assert -async2sync -map +/cyclone2/cells_sim.v synth_cyclone2 -noiopad # equivalency check
design -load postopt # load the post-opt design (otherwise equiv_opt loads the pre-opt design)
cd dff # Constrain all select calls below inside the top module
select -assert-count 1 t:LCELL_FF
select -assert-none t:LCELL_FF %% t:* %D

design -load read
hierarchy -top dffe
proc
equiv_opt -assert -async2sync -map +/cyclone2/cells_sim.v synth_cyclone2 -noiopad # equivalency check
design -load postopt # load the post-opt design (otherwise equiv_opt loads the pre-opt design)
cd dffe # Constrain all select calls below inside the top module
select -assert-count 1 t:LCELL_FF
select -assert-none t:LCELL_FF %% t:* %D
