#start:The following commands are executed by this synthesis command:
#end:$
begin:
    hierarchy -check [-top <top> | -auto-top]
    optbarriers    (if -barriers)
    proc [-ifx]

formal:    (if -formal)
    setundef -undriven -anyseq
    peepopt -formalclk
    check -assert
    memory_nordff
    async2sync    (if -formal without multiclock)
    clk2fflogic -nopeepopt -nolower    (if -formal multiclock)
    chformal -lower
    memory_map -formal
    formalff -setundef -ff2anyinit -hierarchy

coarse:
    check
    flatten [-barriers]    (if -flatten)
    future
    opt_expr -keepdc
    check
    opt_clean
    opt -noff -keepdc
    wreduce -keepdc [-memx]
    memory_dff    (if -rdff)
    memory_memx    (if -memx)
    opt_clean
    memory_collect
    opt -noff -keepdc -fast
    sort

check:
    stat
    check
