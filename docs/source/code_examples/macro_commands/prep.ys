#start:The following commands are executed by this synthesis command:
#end:$
begin:
    hierarchy -check [-top <top> | -auto-top]

coarse:
    optbarriers    (if -barriers)
    setundef -undriven -anyseq    (if -formal)
    proc [-ifx]
    memory_nordff    (if -formal)
    async2sync    (if -formal without multiclock)
    clk2fflogic    (if -formal multiclock)
    chformal -lower    (if -formal)
    memory_map -formal    (if -formal)
    formalff -setundef -clk2ff -ff2anyinit -hierarchy    (if -formal)
    check
    flatten [-barriers]    (if -flatten)
    future
    opt_expr -keepdc
    check
    opt_clean
    opt -noff -keepdc
    wreduce -keepdc [-memx]
    memory_dff    (if -rdff)
    memory_memx    (if -memx)
    opt_clean
    memory_collect
    opt -noff -keepdc -fast
    sort

check:
    stat
    check
