#start:The following commands are executed by this synthesis command:
#end:$
begin:
    hierarchy -check [-top <top> | -auto-top]

coarse:
    optbarriers    (if -barriers)
    proc [-ifx]
    check
    flatten [-barriers]    (if -flatten)
    future
    opt_expr -keepdc
    check
    opt_clean
    opt -noff -keepdc
    wreduce -keepdc [-memx]
    memory_dff    (if -rdff)
    memory_memx    (if -memx)
    opt_clean
    memory_collect
    opt -noff -keepdc -fast
    sort

check:
    stat
    check
